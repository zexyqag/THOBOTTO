@page "/g/{GuildId:long}/music"
@attribute [Authorize]
@inherits GuildPage
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@using THOBOTTO.Data
@using THOBOTTO.Discord
@using THOBOTTO.Helpers
@inject IDbContextFactory<BotDbContext> DbFactory
@inject MusicService Music
@inject VoicePresence Presence
@inject ModuleState Modules
@inject PanelNames Names
@inject PlaylistBook Playlists

<PageTitle>Music · THOBOTTO</PageTitle>

@if (!Ready)
{
    <p class="muted">You aren't in that server, or the bot isn't.</p>
}
else
{
    <GuildNav Guild="Guild" Current="music" />
    <h1>Music</h1>
    @if (_message is not null)
    {
        <p class="notice @(_failed ? "bad" : "good")">@_message</p>
    }
    @if (!_enabled)
    {
        <p class="muted">@ModuleRegistry.Off(MusicService.ModuleId)</p>
    }
    else
    {
        <p class="muted">What's playing now, with its lyrics and the queue, is in the Activity: open it in the voice channel, or in a browser at <a href="/activity/">/activity/</a>.</p>
    }
    <form method="post" @formname="music" @onsubmit="ActAsync">
        <AntiforgeryToken />
        <section class="card">
            <h2>Playlists</h2>
            @if (_playlists.Count == 0)
            {
                <p class="muted">None saved yet. <code>/playlist save</code> keeps what plays in your channel.</p>
            }
            <ul class="perms">
                @foreach (var playlist in _playlists)
                {
                    <li>
                        <div>
                            <strong>@playlist.Name</strong>
                            <small class="muted">@playlist.TrackCount tracks · by @Name(playlist.CreatorId)</small>
                        </div>
                        <div class="row">
                            @if (_enabled && _voiceChannelId is { } here)
                            {
                                <button class="button small" name="act" value="load|@playlist.Id">▶️ Play in @ChannelName(here)</button>
                            }
                            @if (playlist.CreatorId == Member.Id || _canManage)
                            {
                                <button class="button small danger" name="act" value="delete|@playlist.Id">Delete</button>
                            }
                        </div>
                    </li>
                }
            </ul>
            @if (_playlists.Count > 0 && _voiceChannelId is null)
            {
                <p class="muted">Join a voice channel to play one.</p>
            }
        </section>
    </form>

    <h2>Played</h2>
    @if (_plays.Count == 0)
    {
        <p class="muted">@(_earlier ? "Nothing earlier." : "Nothing yet: a song is listed once it has played.")</p>
    }
    else
    {
        <div class="table">
            <table>
                <thead>
                    <tr><th>When</th><th>Song</th><th>Asked for by</th><th>Played</th><th>Listeners</th></tr>
                </thead>
                <tbody>
                    @foreach (var play in _plays)
                    {
                        <tr>
                            <td><When At="play.StartedAt" /></td>
                            <td>
                                @if (play.Uri is { } uri)
                                {
                                    <a href="@uri" target="_blank" rel="noopener">@play.Title</a>
                                }
                                else
                                {
                                    @play.Title
                                }
                                <br /><small class="muted">@play.Artist</small>
                            </td>
                            <td>@(play.Autoplay ? "autoplay" : Name(play.RequestedBy))</td>
                            <td>@Played(play)</td>
                            <td>@(_listeners.TryGetValue(play.Id, out var heard) && heard > 0 ? heard.ToString() : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_plays.Count == PageSize)
        {
            <p><a href="/g/@Guild.Id/music?before=@_plays[^1].Id">Earlier</a></p>
        }
    }
}

@code {
    private const int PageSize = 50;

    private bool _enabled;
    private bool _canManage;
    private IReadOnlyList<SavedPlaylist> _playlists = [];
    private ulong? _voiceChannelId;
    private IReadOnlyList<PlayRecord> _plays = [];
    private bool _earlier;
    private IReadOnlyDictionary<long, int> _listeners = new Dictionary<long, int>();
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private string? _message;
    private bool _failed;

    protected override async Task LoadAsync()
    {
        var guildId = Guild!.Id;
        _enabled = await Modules.IsEnabledAsync(guildId, MusicService.ModuleId);
        _canManage = await CanAsync(BotPermissions.ManageMusic);
        _playlists = await Playlists.ListAsync(guildId);
        _voiceChannelId = Presence.Snapshot(guildId).TryGetValue(Member!.Id, out var where) ? where.ChannelId : null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var plays = db.PlayRecords.AsNoTracking().Where(p => p.GuildId == guildId);
        // The next page starts after the last play shown: those started before it, or with it and written earlier.
        if (long.TryParse(Query("before"), out var before) && await plays.FirstOrDefaultAsync(p => p.Id == before) is { } last)
        {
            plays = plays.Where(p => p.StartedAt < last.StartedAt || p.StartedAt == last.StartedAt && p.Id < last.Id);
            _earlier = true;
        }
        _plays = await plays.OrderByDescending(p => p.StartedAt).ThenByDescending(p => p.Id).Take(PageSize).ToListAsync();
        var ids = _plays.Select(p => p.Id).ToList();
        _listeners = await db.PlayListeners.AsNoTracking().Where(l => ids.Contains(l.PlayId))
            .GroupBy(l => l.PlayId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);
        _names = await Names.NamesAsync(guildId, _plays.Where(p => !p.Autoplay).Select(p => p.RequestedBy).Concat(_playlists.Select(p => p.CreatorId)));
    }

    private async Task ActAsync()
    {
        if (!Ready)
            return;
        (_message, _failed) = (null, false);
        if (Posted("act").Split('|') is [("load" or "delete") and var what, var playlistId])
            await PlaylistAsync(what, playlistId);
        _message = Plain(_message);
        await LoadAsync();
    }

    private async Task PlaylistAsync(string what, string id)
    {
        if (_playlists.FirstOrDefault(p => p.Id.ToString() == id) is not { } listed)
        {
            (_message, _failed) = ("That playlist is gone.", true);
            return;
        }
        if (what == "delete")
        {
            _message = await Playlists.DeleteAsync(Guild!.Id, listed.Name, Member!.Id, _canManage);
            _failed = !_message.StartsWith("🗑️");
            return;
        }
        if (!_enabled || _voiceChannelId is not { } channelId || await Playlists.FindAsync(Guild!.Id, listed.Name) is not { } found)
        {
            (_message, _failed) = ("Join a voice channel to play it.", true);
            return;
        }
        var textChannelId = Music.PlayerIn(Guild.Id, channelId)?.TextChannelId ?? channelId;
        var tracks = found.Tracks.Select(t => t with { RequestedBy = Member!.Id }).ToList();
        var reply = await Music.QueueAsync(Guild.Id, Member!.Id, channelId, textChannelId, tracks, found.Playlist.Name, Placement.Last);
        (_message, _failed) = (reply, !reply.StartsWith("▶️") && !reply.StartsWith("➕"));
    }

    // How much of it played: all of it, or how far it got of its length before a skip or a stop.
    private static string Played(PlayRecord play)
        => play.Skipped ? $"{Track.Duration(play.PlayedMs)} of {Track.Duration(play.LengthMs)}" : Track.Duration(play.PlayedMs);

    // Discord markdown in replies: links become their titles, bold goes.
    private static string? Plain(string? text)
        => text is null ? null : Regex.Replace(text, @"\[([^\]]*)\]\([^)]*\)", "$1").Replace("**", "");

    private string Name(ulong id) => _names.GetValueOrDefault(id) ?? id.ToString();

    private string ChannelName(ulong id) => Guild!.Channels.TryGetValue(id, out var channel) ? channel.Name : id.ToString();
}
