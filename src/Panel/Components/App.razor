<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["panel.css"]" />
    <title>THOBOTTO</title>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script>
        // Offers the browser's own time zone where a page asks for it.
        const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        for (const input of document.querySelectorAll("input[data-browser-zone-input]"))
            input.value = zone;
        for (const offer of document.querySelectorAll("[data-browser-zone]")) {
            if (!zone || offer.dataset.browserZone === zone) continue;
            offer.querySelector("input").value = zone;
            offer.querySelector(".zone").textContent = zone;
            offer.hidden = false;
        }
        for (const t of document.querySelectorAll("time[datetime]"))
            t.textContent = new Date(t.dateTime).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });

        // Moves music progress along; when a track ends, loads the page again (without resending a form) for the next one.
        const loaded = Date.now();
        const playing = [...document.querySelectorAll("[data-elapsed]")].filter(p => +p.dataset.length > 0 && !p.dataset.paused);
        const clock = ms => { const s = Math.floor(ms / 1000), h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60, pad = n => String(n).padStart(2, "0");
            return h ? `${h}:${pad(m)}:${pad(s % 60)}` : `${m}:${pad(s % 60)}`; };
        if (playing.length)
            setInterval(() => {
                for (const p of playing) {
                    const at = +p.dataset.elapsed + Date.now() - loaded;
                    if (at > +p.dataset.length + 2000) location.replace(location.pathname);
                    p.querySelector("progress").value = Math.min(at, +p.dataset.length);
                    p.querySelector(".at").textContent = clock(Math.min(at, +p.dataset.length));
                }
            }, 1000);
    </script>
</body>
</html>
