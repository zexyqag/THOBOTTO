@page "/g/{GuildId:long}/me"
@attribute [Authorize]
@inherits GuildPage
@using NodaTime
@using THOBOTTO.Events
@using THOBOTTO.Notifications
@inject TimeZones Zones
@inject Notifier Notifier
@inject TimeProvider Time
@inject THOBOTTO.Lastfm.Scrobbler Scrobbler
@inject THOBOTTO.Stats.WrappedService Wrapped
@inject THOBOTTO.Listening.VoicePrefs VoicePrefs
@inject SettingsStore Settings
@inject ModuleState Modules

<PageTitle>You · THOBOTTO</PageTitle>

@if (!Ready)
{
    <p class="muted">You aren't in that server, or the bot isn't.</p>
}
else
{
    <GuildNav Guild="Guild" Current="me" />
    <h1>You</h1>
    @if (_message is not null)
    {
        <p class="notice @(_failed ? "bad" : "good")">@_message</p>
    }
    <form method="post" @formname="me" @onsubmit="SaveAsync">
        <AntiforgeryToken />
        <section class="card">
            <h2>Time zone</h2>
            <p>
                The times you type for events and sessions are read in <strong>@_zone!.Id</strong>
                (it's @Now(_zone) there)@(_own ? "." : ", the server's; you haven't set your own.")
                It's the same in every server.
            </p>
            <p class="row" data-browser-zone="@_zone.Id" hidden>
                <input type="hidden" name="browser-zone" />
                Your browser says <strong class="zone"></strong>.
                <button class="button small" name="act" value="browser">Use that</button>
            </p>
            <div class="row">
                <input name="zone" list="zones" placeholder="Or pick one: start typing a city" class="grow" aria-label="Time zone" />
                <button class="button small secondary" name="act" value="zone">Set</button>
                @if (_own)
                {
                    <button class="button small secondary" name="act" value="server-zone">Use the server's</button>
                }
            </div>
            <datalist id="zones">
                @foreach (var id in TimeZones.Ids)
                {
                    <option value="@id"></option>
                }
            </datalist>
        </section>

        <section class="card">
            <h2>DMs from the bot</h2>
            <p class="muted">What the bot tells you about in a direct message, in this server.</p>
            @foreach (var topic in _topics)
            {
                <div class="field">
                    <label class="check"><input type="checkbox" name="topic" value="@topic.Id" checked="@_subscribed.Contains(topic.Id)" /> @topic.Description</label>
                </div>
            }
            <button class="button small" name="act" value="dms">Save DMs</button>
        </section>

        @if (_listeningOn || _musicJoinAllowed)
        {
            <section class="card">
                <h2>Voice</h2>
                @if (_listeningOn)
                {
                    <p class="muted">
                        Say a helper's name and what to do: "Jeeves, play Thunderstruck", "skip", "pause", "louder", "what's playing". A helper listens where
                        you summon it with <code>/listen</code>@(_autoListenAllowed ? ", or wherever you are if you let it join you" : ""). It only ever hears members who
                        switch this on, and keeps nothing that's said.
                    </p>
                    <div class="row">
                        <button class="toggle @(_voice.Listen ? "on" : "off")" name="act" value="voice-listen">@(_voice.Listen ? "Helpers hear me" : "Helpers don't hear me")</button>
                        @if (_autoListenAllowed && _voice.Listen)
                        {
                            <button class="toggle @(_voice.AutoListen ? "on" : "off")" name="act" value="voice-autolisten">@(_voice.AutoListen ? "A helper joins me to listen" : "Only when I summon one")</button>
                        }
                    </div>
                }
                @if (_musicJoinAllowed)
                {
                    <p class="muted">A free helper can join your voice channel whenever you're in one, ready for <code>/play</code> or a voice command.</p>
                    <button class="toggle @(_voice.AutoMusic ? "on" : "off")" name="act" value="voice-automusic">@(_voice.AutoMusic ? "A helper joins me for music" : "No music helper joins me")</button>
                }
            </section>
        }
        <section class="card">
            <h2>Wrapped</h2>
            <p class="muted">Everyone's listening counts in this server's totals. Opt in to be named in rankings like top DJs and listening buddies, for everything you've done here, also from before. <a href="/g/@Guild.Id/wrapped">See your Wrapped</a>.</p>
            <button class="toggle @(_wrappedIn ? "on" : "off")" name="act" value="wrapped-@(_wrappedIn ? "out" : "in")">@(_wrappedIn ? "Named in Wrapped" : "Not named in Wrapped")</button>
        </section>
        @if (Scrobbler.Configured)
        {
            <section class="card">
                <h2>Last.fm</h2>
                @if (_lastfm is { } link)
                {
                    <p>
                        @(link.Scrobbling ? "Scrobbling to" : "Linked to, paused:")
                        <a href="https://www.last.fm/user/@Uri.EscapeDataString(link.Username)" target="_blank" rel="noopener">@link.Username</a>
                    </p>
                    <p class="muted">What the helpers play is scrobbled while you're in the voice channel and not deafened, in every server. A track counts once you've heard half of it (or 4 minutes), from the start.</p>
                    <div class="row">
                        <button class="button small secondary" name="act" value="@(link.Scrobbling ? "lastfm-pause" : "lastfm-resume")">@(link.Scrobbling ? "Pause scrobbling" : "Resume scrobbling")</button>
                        <button class="button small danger" name="act" value="lastfm-unlink">Disconnect</button>
                    </div>
                }
                else
                {
                    <p class="muted">Link your Last.fm account and what you listen to with the helpers shows up there, in every server.</p>
                    <a class="button small" href="/lastfm/connect?back=@Uri.EscapeDataString($"/g/{Guild.Id}/me")">Connect Last.fm</a>
                }
            </section>
        }
        <section class="card">
            <h2>What you can do here</h2>
            @if (_permissions.Count == 0)
            {
                <p class="muted">No bot permissions: the everyday commands are yours, the rest is for the server's admins.</p>
            }
            else
            {
                <ul class="links">
                    @foreach (var (permission, source) in _permissions)
                    {
                        <li><code>@permission</code> <small class="muted">via @Strip(source)</small></li>
                    }
                </ul>
            }
        </section>
    </form>
}

@code {
    private DateTimeZone? _zone;
    private bool _own;
    private IReadOnlyList<NotificationTopic> _topics = [];
    private IReadOnlySet<string> _subscribed = new HashSet<string>();
    private IReadOnlyList<(string Permission, string Source)> _permissions = [];
    private THOBOTTO.Lastfm.LastfmLink? _lastfm;
    private bool _wrappedIn;
    private bool _listeningOn;
    private bool _autoListenAllowed;
    private bool _musicJoinAllowed;
    private THOBOTTO.Listening.VoicePreference _voice = new();
    private string? _message;
    private bool _failed;

    protected override async Task LoadAsync()
    {
        (_zone, _own) = await Zones.ForAsync(Guild!.Id, Member!.Id);
        _topics = await Notifier.TopicsAsync(Guild.Id);
        _subscribed = await Notifier.SubscriptionsAsync(Guild.Id, Member.Id);
        _permissions = await Access.Control.ExplainAsync(Guild, Member);
        _lastfm = await Scrobbler.FindAsync(Member.Id);
        _wrappedIn = await Wrapped.IsInAsync(Guild.Id, Member.Id);
        _listeningOn = await Modules.IsEnabledAsync(Guild.Id, THOBOTTO.Listening.VoiceEars.ModuleId);
        _autoListenAllowed = (await Settings.GetAsync<THOBOTTO.Listening.ListeningRules>(Guild.Id, THOBOTTO.Listening.VoiceEars.ModuleId)).AutoListenAllowed;
        _musicJoinAllowed = await Modules.IsEnabledAsync(Guild.Id, THOBOTTO.Music.MusicService.ModuleId)
            && (await Settings.GetAsync<THOBOTTO.Music.MusicRules>(Guild.Id, THOBOTTO.Music.MusicService.ModuleId)).AutoJoinAllowed;
        _voice = await VoicePrefs.GetAsync(Guild.Id, Member.Id);
        if (_message is null && Query("lastfm") is { Length: > 0 } outcome)
            (_message, _failed) = outcome == "linked" ? ($"Linked to Last.fm as {_lastfm?.Username}.", false) : ("Linking Last.fm didn't work; try again.", true);
    }

    private async Task SaveAsync()
    {
        if (!Ready)
            return;
        _failed = false;
        switch (Posted("act"))
        {
            case "browser" or "zone":
                var asked = Posted(Posted("act") == "browser" ? "browser-zone" : "zone").Trim();
                if (TimeZones.Find(asked) is { } zone)
                {
                    await Zones.SetAsync(Member!.Id, zone.Id);
                    _message = $"Your time zone is {zone.Id} now.";
                }
                else
                    (_message, _failed) = ("That isn't a time zone I know; pick one from the list.", true);
                break;
            case "lastfm-pause" or "lastfm-resume":
                await Scrobbler.SetScrobblingAsync(Member!.Id, Posted("act") == "lastfm-resume");
                _message = Posted("act") == "lastfm-resume" ? "Scrobbling again." : "Scrobbling paused.";
                break;
            case "voice-listen":
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => (p.Listen, p.AutoListen) = (!p.Listen, false));
                _message = "Saved.";
                break;
            case "voice-autolisten" when _autoListenAllowed:
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => p.AutoListen = p.Listen && !p.AutoListen);
                _message = "Saved.";
                break;
            case "voice-automusic" when _musicJoinAllowed:
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => p.AutoMusic = !p.AutoMusic);
                _message = "Saved.";
                break;
            case "wrapped-in" or "wrapped-out":
                await Wrapped.SetInAsync(Guild.Id, Member!.Id, Posted("act") == "wrapped-in");
                _message = Posted("act") == "wrapped-in" ? "You're named in this server's Wrapped now." : "You're no longer named in this server's Wrapped.";
                break;
            case "lastfm-unlink":
                await Scrobbler.UnlinkAsync(Member!.Id);
                _message = "Last.fm disconnected. You can also remove THOBOTTO from your Last.fm applications.";
                break;
            case "server-zone":
                await Zones.ClearAsync(Member!.Id);
                _message = "You follow the server's time zone now.";
                break;
            case "dms":
                var wanted = HttpContext.Request.Form["topic"].Select(t => t ?? "").ToHashSet();
                foreach (var topic in _topics)
                {
                    if (wanted.Contains(topic.Id) != _subscribed.Contains(topic.Id))
                        await Notifier.SetAsync(Guild.Id, Member!.Id, topic.Id, wanted.Contains(topic.Id));
                }
                _message = "Saved.";
                break;
        }
        await LoadAsync();
    }

    private string Now(DateTimeZone zone) => Instant.FromDateTimeOffset(Time.GetUtcNow()).InZone(zone).ToString("HH:mm, ddd d MMM", null);

    // Explanations name roles as Discord mentions; here they read as role names.
    private string Strip(string source) => System.Text.RegularExpressions.Regex.Replace(source, @"<@&(\d+)>",
        m => Guild!.Roles.TryGetValue(ulong.Parse(m.Groups[1].Value), out var role) ? role.Name : "a deleted role");
}
