@page "/integrations"
@attribute [Authorize]
@using THOBOTTO.Integrations
@using THOBOTTO.Listening
@inject PanelAccess Access
@inject IntegrationStore Store
@inject IntegrationStatus Status
@inject YoutubeSignIn Youtube
@inject TimeProvider Time

<PageTitle>Integrations · THOBOTTO</PageTitle>

@if (!_owner)
{
    <p class="muted">Integrations are managed by the bot's owner.</p>
}
else
{
    @if (Youtube.Waiting is not null)
    {
        <HeadContent><meta http-equiv="refresh" content="5;url=/integrations" /></HeadContent>
    }
    <h1>Integrations</h1>
    <p class="muted">The outside services the bot uses, and whether they work. Settings here are stored encrypted and take effect at once.</p>
    @if (_message is not null)
    {
        <p class="notice @(_failed ? "bad" : "good")">@_message</p>
    }

    <section class="card">
        <h2>Status</h2>
        <ul class="checks">
            @foreach (var check in _checks)
            {
                <li class="@check.State.ToString().ToLowerInvariant()">
                    <strong>@check.Name</strong>
                    <span>@check.Detail</span>
                </li>
            }
        </ul>
    </section>

    <form method="post" @formname="integrations" @onsubmit="ActAsync">
        <AntiforgeryToken />
        <section class="card">
            <h2>YouTube sign-in</h2>
            @if (Youtube.Waiting is { } waiting)
            {
                <p>Go to <a href="@waiting.Url" target="_blank" rel="noopener">@waiting.Url</a> and enter</p>
                <p class="code">@waiting.UserCode</p>
                <p class="muted">Waiting for you to approve… this page checks every few seconds. The code works for @((int)Math.Max(1, (waiting.Expires - Time.GetUtcNow()).TotalMinutes)) more minutes.</p>
                <button class="button small secondary" name="act" value="youtube-cancel">Cancel</button>
            }
            else
            {
                @if (Youtube.Outcome is { } outcome)
                {
                    <p class="notice @(outcome == "Signed in." ? "good" : "bad")">@outcome</p>
                }
                <p class="muted">Signed in, the YouTube plugin gets past "sign in to confirm you're not a bot". <strong>Use a throwaway Google account</strong>: YouTube may flag accounts used like this.</p>
                <div class="row">
                    <button class="button small" name="act" value="youtube-start">Sign in with Google</button>
                    @if (Store.Get(IntegrationStore.YoutubeRefreshToken) is not null)
                    {
                        <button class="button small danger" name="act" value="youtube-forget">Forget the sign-in</button>
                    }
                </div>
            }
        </section>

        <section class="card">
            <h2>Panel login</h2>
            <p class="muted">Anyone can log in with a <code>/panel</code> link from Discord. With the client secret from the bot's OAuth2 page in the Discord Developer Portal, "Log in with Discord" works too.</p>
            <div class="field">
                <label for="panel-secret">Client secret</label>
                <input id="panel-secret" name="panel-secret" type="password" autocomplete="new-password" placeholder="@Placeholder(IntegrationStore.PanelClientSecret)" />
            </div>
            <div class="row">
                <button class="button small" name="act" value="panel-save">Save</button>
                <button class="button small secondary" name="act" value="panel-clear">Clear</button>
            </div>
        </section>

        <section class="card">
            <h2>Spotify</h2>
            <p class="muted">From your app on developer.spotify.com.</p>
            <div class="field">
                <label for="spotify-id">Client ID</label>
                <input id="spotify-id" name="spotify-id" autocomplete="off" placeholder="@Placeholder(IntegrationStore.SpotifyClientId)" />
            </div>
            <div class="field">
                <label for="spotify-secret">Client secret</label>
                <input id="spotify-secret" name="spotify-secret" type="password" autocomplete="new-password" placeholder="@Placeholder(IntegrationStore.SpotifyClientSecret)" />
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" name="spotify-albums" value="true" checked="@(Store.Get(IntegrationStore.SpotifyAlbumsAndPlaylists) == "true")" /> Albums, artists, playlists and Spotify search</label>
                <small class="muted">Needs the Spotify token service running in the stack (spotify-tokener: 1).</small>
            </div>
            <div class="row">
                <button class="button small" name="act" value="spotify-save">Save</button>
                <button class="button small secondary" name="act" value="spotify-clear">Clear</button>
            </div>
        </section>

        <section class="card">
            <h2>Voice relay (experimental)</h2>
            <p class="muted">
                Helpers play through their own voice connection: Lavalink plays into a relay in the bot instead of straight into Discord. The helper playing
                in a channel then hears voice commands itself, so no other helper has to listen. Lavalink has to trust the relay's certificate (see the
                deployment notes). If something goes wrong, switch it off: helpers go back to the normal way.
            </p>
            <button class="toggle @(Store.Get(IntegrationStore.VoiceRelay) == "on" ? "on" : "off")" name="act" value="relay-toggle">@(Store.Get(IntegrationStore.VoiceRelay) == "on" ? "On" : "Off")</button>
            <small class="muted">Applies to helpers joining from now on.</small>
        </section>

        <section class="card">
            <h2>Speech (voice commands)</h2>
            <p class="muted">How what members say to a helper is turned into text. Only members who opt in are ever listened to.</p>
            <div class="field">
                <label class="check"><input type="radio" name="speech-engine" value="local" checked="@(Store.Get(IntegrationStore.SpeechEngine) != "cloud")" /> Whisper on this server: free, nothing leaves it</label>
                <select name="speech-model" aria-label="Whisper model">
                    @foreach (var (type, name) in LocalWhisper.Models)
                    {
                        <option value="@type" selected="@(Store.Get(IntegrationStore.SpeechLocalModel) == type.ToString() || Store.Get(IntegrationStore.SpeechLocalModel) is null && type == Whisper.net.Ggml.GgmlType.BaseEn)">@name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="check"><input type="radio" name="speech-engine" value="cloud" checked="@(Store.Get(IntegrationStore.SpeechEngine) == "cloud")" /> A cloud service: faster and more accurate; what's said goes to that company</label>
                <input name="speech-url" autocomplete="off" placeholder="@($"Address (default {CloudSpeech.DefaultUrl}: Groq)")" value="@Store.Get(IntegrationStore.SpeechCloudUrl)" />
                <input name="speech-key" type="password" autocomplete="new-password" placeholder="@Placeholder(IntegrationStore.SpeechCloudKey)" />
                <input name="speech-cloud-model" autocomplete="off" placeholder="@($"Model (default {CloudSpeech.DefaultModel})")" value="@Store.Get(IntegrationStore.SpeechCloudModel)" />
            </div>
            <div class="field">
                <label for="understanding-url">Commands in members' own words</label>
                <input id="understanding-url" name="understanding-url" autocomplete="off" placeholder="Language model server, e.g. http://llm:8080 (empty: set phrases only)" value="@Store.Get(IntegrationStore.UnderstandingUrl)" />
                <small class="muted">A llama.cpp server (or another OpenAI-style one) on your stack reads what the set phrases don't catch, like "give Ana five points" or "throw on some ABBA after this".</small>
            </div>
            <div class="row">
                <button class="button small" name="act" value="speech-save">Save</button>
            </div>
        </section>

        <section class="card">
            <h2>Last.fm</h2>
            <p class="muted">
                For scrobbling, blends and genres in Wrapped. Create an API account at last.fm/api/account/create with the callback URL
                <code>@($"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/lastfm/callback")</code>.
            </p>
            <div class="field">
                <label for="lastfm-key">API key</label>
                <input id="lastfm-key" name="lastfm-key" autocomplete="off" placeholder="@Placeholder(IntegrationStore.LastfmApiKey)" />
            </div>
            <div class="field">
                <label for="lastfm-secret">Shared secret</label>
                <input id="lastfm-secret" name="lastfm-secret" type="password" autocomplete="new-password" placeholder="@Placeholder(IntegrationStore.LastfmApiSecret)" />
            </div>
            <div class="row">
                <button class="button small" name="act" value="lastfm-save">Save</button>
                <button class="button small secondary" name="act" value="lastfm-clear">Clear</button>
            </div>
        </section>
    </form>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool _owner;
    private ulong _userId;
    private IReadOnlyList<Check> _checks = [];
    private string? _message;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        if (PanelAccess.UserId((await AuthState).User) is not { } userId || !await Access.IsBotOwnerAsync(userId))
            return;
        (_userId, _owner) = (userId, true);
        _checks = await Status.CheckAsync();
    }

    // Secrets never come back to the browser: only whether one is set.
    private string Placeholder(string key) => Store.Get(key) is null ? "Not set" : "Set (type to replace)";

    private string Posted(string name) => HttpContext.Request.Form[name].ToString().Trim();

    private async Task ActAsync()
    {
        if (!_owner)
            return;
        (_message, _failed) = (null, false);
        switch (Posted("act"))
        {
            case "youtube-start":
                try
                {
                    await Youtube.StartAsync(_userId);
                }
                catch (HttpRequestException ex)
                {
                    (_message, _failed) = ($"Google couldn't be reached: {ex.Message}", true);
                }
                break;
            case "youtube-cancel":
                Youtube.Cancel();
                break;
            case "youtube-forget":
                await Store.SetAsync(IntegrationStore.YoutubeRefreshToken, null, _userId);
                _message = "Forgot the sign-in; YouTube plays signed out once Lavalink restarts.";
                break;
            case "panel-save":
                await SetIfGivenAsync(IntegrationStore.PanelClientSecret, Posted("panel-secret"));
                _message = "Saved: \"Log in with Discord\" works when the bot's OAuth2 page has the panel's /signin-discord redirect.";
                break;
            case "panel-clear":
                await Store.SetAsync(IntegrationStore.PanelClientSecret, null, _userId);
                _message = "Cleared: only /panel links log in now.";
                break;
            case "spotify-save":
                await SetIfGivenAsync(IntegrationStore.SpotifyClientId, Posted("spotify-id"));
                await SetIfGivenAsync(IntegrationStore.SpotifyClientSecret, Posted("spotify-secret"));
                await Store.SetAsync(IntegrationStore.SpotifyAlbumsAndPlaylists, Posted("spotify-albums") == "true" ? "true" : "false", _userId);
                _message = "Spotify settings saved and sent to Lavalink.";
                break;
            case "spotify-clear":
                foreach (var key in new[] { IntegrationStore.SpotifyClientId, IntegrationStore.SpotifyClientSecret, IntegrationStore.SpotifyAlbumsAndPlaylists })
                    await Store.SetAsync(key, null, _userId);
                _message = "Spotify settings cleared; Lavalink stops using them once it restarts.";
                break;
            case "relay-toggle":
                var relayOn = Store.Get(IntegrationStore.VoiceRelay) != "on";
                await Store.SetAsync(IntegrationStore.VoiceRelay, relayOn ? "on" : null, _userId);
                _message = relayOn ? "Helpers join through the relay from now on." : "Helpers join the normal way from now on.";
                break;
            case "speech-save":
                await Store.SetAsync(IntegrationStore.SpeechEngine, Posted("speech-engine") == "cloud" ? "cloud" : null, _userId);
                await Store.SetAsync(IntegrationStore.SpeechLocalModel, Posted("speech-model"), _userId);
                await Store.SetAsync(IntegrationStore.SpeechCloudUrl, Posted("speech-url"), _userId);
                await Store.SetAsync(IntegrationStore.SpeechCloudModel, Posted("speech-cloud-model"), _userId);
                await Store.SetAsync(IntegrationStore.UnderstandingUrl, Posted("understanding-url"), _userId);
                await SetIfGivenAsync(IntegrationStore.SpeechCloudKey, Posted("speech-key"));
                _message = "Speech settings saved.";
                break;
            case "lastfm-save":
                await SetIfGivenAsync(IntegrationStore.LastfmApiKey, Posted("lastfm-key"));
                await SetIfGivenAsync(IntegrationStore.LastfmApiSecret, Posted("lastfm-secret"));
                _message = "Last.fm settings saved.";
                break;
            case "lastfm-clear":
                await Store.SetAsync(IntegrationStore.LastfmApiKey, null, _userId);
                await Store.SetAsync(IntegrationStore.LastfmApiSecret, null, _userId);
                _message = "Last.fm settings cleared.";
                break;
        }
        _checks = await Status.CheckAsync();
    }

    // An empty box keeps what's there.
    private async Task SetIfGivenAsync(string key, string value)
    {
        if (value.Length > 0)
            await Store.SetAsync(key, value, _userId);
    }
}
