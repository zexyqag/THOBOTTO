@page "/"
@inject PanelAccess Access
@inject NetCord.Gateway.GatewayClient Gateway
@inject THOBOTTO.Integrations.IntegrationStore Store
@inject PanelLinks Links

<PageTitle>THOBOTTO</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <section class="card center">
            <h1>THOBOTTO</h1>
            <p>Manage the bot for your server.</p>
            @if (_discordLogin)
            {
                <a class="button" href="/login">Log in with Discord</a>
                <p class="muted">Or type <code>/panel</code> in Discord for a login link.</p>
            }
            else
            {
                <p>Type <code>/panel</code> in Discord for a link that logs you in.</p>
            }
            @if (Gateway.Cache.User is { } bot)
            {
                <p><a href="@BotInvite.Url(bot.Id)" target="_blank" rel="noopener">Add THOBOTTO to a server</a></p>
            }
        </section>
    </NotAuthorized>
    <Authorized>
        <p class="row">
            @if (Gateway.Cache.User is { } bot)
            {
                <a class="button secondary" href="@BotInvite.Url(bot.Id)" target="_blank" rel="noopener">Add THOBOTTO to a server</a>
            }
            @if (_owner)
            {
                <a class="button secondary" href="/helpers">Helper bots</a>
                <a class="button secondary" href="/integrations">Integrations</a>
            }
        </p>
        <h1>Your servers</h1>
        @if (_guilds is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_guilds.Count == 0)
        {
            <p class="muted">You don't share a server with the bot.</p>
        }
        else
        {
            <ul class="guilds">
                @foreach (var guild in _guilds)
                {
                    <li>
                        <a href="/g/@guild.Id">
                            @if (guild.IconHash is { } icon)
                            {
                                <img src="https://cdn.discordapp.com/icons/@guild.Id/@(icon).png?size=64" alt="" />
                            }
                            else
                            {
                                <span class="initial">@guild.Name[..1]</span>
                            }
                            <span>@guild.Name</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<Guild>? _guilds;
    private bool _owner;
    private bool _discordLogin;

    protected override async Task OnInitializedAsync()
    {
        _discordLogin = await DiscordLogin.AvailableAsync(Store, Links);
        if (PanelAccess.UserId((await AuthState).User) is { } userId)
        {
            _guilds = await Access.GuildsAsync(userId);
            _owner = await Access.IsBotOwnerAsync(userId);
        }
    }
}
