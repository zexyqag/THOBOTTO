@inject PanelAccess Access
@inject ModuleState Modules

@if (_preview is { } preview)
{
    <p class="notice preview">
        👁️ Viewing as @(preview == Guild.Id ? "a member without roles" : Guild.Roles.TryGetValue(preview, out var role) ? $"@{role.Name}" : "a role"): only what they see, and nothing can be changed.
        <a href="/g/@Guild.Id/view-as">Stop</a>
    </p>
}
<nav class="guildnav">
    <a href="/g/@Guild.Id" class="@(Current == "" ? "here" : "")">@Guild.Name</a>
    @foreach (var item in _shown)
    {
        <a href="/g/@Guild.Id/@item.Path" class="@(Current == item.Path ? "here" : "")">@item.Label</a>
    }
</nav>

@code {
    [Parameter, EditorRequired]
    public Guild Guild { get; set; } = default!;

    [Parameter]
    public string Current { get; set; } = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Each page, what it needs (a permission, its module on), in menu order.
    private static readonly (string Path, string Label, string? Permission, string? Module)[] All =
    [
        ("events", "Events", null, THOBOTTO.Events.EventBoard.ModuleId),
        ("points", "Points", null, THOBOTTO.Points.PointsEngine.ModuleId),
        ("music", "Music", null, THOBOTTO.Music.MusicService.ModuleId),
        ("wrapped", "Wrapped", null, THOBOTTO.Stats.WrappedPoster.ModuleId),
        ("sounds", "Sounds", null, THOBOTTO.Sounds.SoundBoard.ModuleId),
        ("me", "You", null, null),
        ("permissions", "Permissions", BotPermissions.ManagePermissions, null),
        ("helpers", "Helpers", BotPermissions.ManageHelpers, null),
        ("moderation", "Moderation", BotPermissions.ModWarn, null),
        ("automod", "AutoMod", BotPermissions.ModManage, null),
        ("voice-log", "Voice log", BotPermissions.ManageMusic, THOBOTTO.Listening.VoiceEars.ModuleId),
        ("archive", "Archive", BotPermissions.ManageArchive, null),
        ("audit", "Audit log", BotPermissions.ManagePermissions, null),
        ("backup", "Backup", BotPermissions.ManagePermissions, null),
    ];

    private List<(string Path, string Label, string? Permission, string? Module)> _shown = [];
    private ulong? _preview;

    protected override async Task OnParametersSetAsync()
    {
        _preview = Access.PreviewOf(Guild.Id);
        _shown = [];
        if (PanelAccess.UserId((await AuthState).User) is not { } userId || await Access.InAsync(Guild.Id, userId) is not var (_, member))
            return;
        foreach (var page in All)
        {
            if ((page.Module is null || await Modules.IsEnabledAsync(Guild.Id, page.Module)) && (page.Permission is null || await Access.CanAsync(Guild, member, page.Permission)))
                _shown.Add(page);
        }
    }
}
