@page "/g/{GuildId:long}/wrapped"
@attribute [Authorize]
@inherits GuildPage
@using System.Text.RegularExpressions
@inject WrappedService Wrapped
@inject WrappedNames Names
@inject ModuleState Modules

<PageTitle>Wrapped · THOBOTTO</PageTitle>

@if (!Ready)
{
    <p class="muted">You aren't in that server, or the bot isn't.</p>
}
else
{
    <GuildNav Guild="Guild" Current="wrapped" />
    <h1>Wrapped</h1>
    @if (_message is not null)
    {
        <p class="notice good">@_message</p>
    }
    @if (!_enabled)
    {
        <p class="muted">@ModuleRegistry.Off(WrappedPoster.ModuleId) It's switched on from the server's page.</p>
    }
    <form method="get" class="row filters">
        <select name="view" aria-label="Whose Wrapped">
            <option value="me" selected="@(_view == "me")">You</option>
            <option value="server" selected="@(_view == "server")">@Guild.Name</option>
            @foreach (var (key, name) in _voices)
            {
                <option value="@key" selected="@(_view == key)">🎙️ @name</option>
            }
        </select>
        <select name="period" aria-label="When">
            @foreach (var period in _periods)
            {
                <option value="@period" selected="@(_period == period)">@Label(period)</option>
            }
        </select>
        <button class="button small">Show</button>
    </form>
    @if (!_periods.Contains(WrappedPeriod.ThisYear))
    {
        <p class="muted">This year's Wrapped is revealed at noon on December 31st.</p>
    }

    @foreach (var card in _cards)
    {
        <section class="card wrapped" style="@(card.Color is { } c ? $"--role: #{c:x6}" : "")">
            <h2>@card.Title</h2>
            @if (card.Intro is not null)
            {
                <p class="intro">@card.Intro</p>
            }
            @if (card.Facts.Count > 0)
            {
                <dl class="facts">
                    @foreach (var (label, value) in card.Facts)
                    {
                        <div><dt>@label</dt><dd>@value</dd></div>
                    }
                </dl>
            }
            <div class="lists">
                @foreach (var (heading, lines) in card.Lists)
                {
                    <div>
                        <h3>@heading</h3>
                        <ol>
                            @foreach (var line in lines)
                            {
                                <li>@Regex.Replace(line, @"^\d+\. ", "")</li>
                            }
                        </ol>
                    </div>
                }
            </div>
        </section>
    }

    <form method="post" @formname="wrapped" @onsubmit="SetInAsync" class="card">
        <AntiforgeryToken />
        <h2>Your name in Wrapped</h2>
        <p class="muted">
            Everyone's listening counts in the totals. Only members who opt in are named in rankings like top DJs or listening buddies,
            for everything they've done, also from before they opted in. Your own Wrapped is always yours to see.
        </p>
        <button class="toggle @(_in ? "on" : "off")" name="in" value="@(!_in)">@(_in ? "Named" : "Not named")</button>
    </form>
}

@code {
    private string _view = "me";
    private WrappedPeriod _period = WrappedPeriod.ThisYear;
    private IReadOnlyList<(string Key, string Name)> _voices = [];
    private IReadOnlyList<WrappedPeriod> _periods = [];
    private IReadOnlyList<WrappedCard> _cards = [];
    private bool _in;
    private bool _enabled;
    private string? _message;

    protected override async Task LoadAsync()
    {
        _view = Query("view") is { Length: > 0 } view ? view : "me";
        _periods = await Wrapped.RevealedAsync(Guild!.Id);
        _period = Enum.TryParse<WrappedPeriod>(Query("period"), out var period) && _periods.Contains(period) ? period
            : _periods.Contains(WrappedPeriod.ThisYear) ? WrappedPeriod.ThisYear : _periods.FirstOrDefault(WrappedPeriod.LastMonth);
        _voices = await Wrapped.VoicesAsync(Guild.Id);
        _in = await Wrapped.IsInAsync(Guild.Id, Member!.Id);
        _enabled = await Modules.IsEnabledAsync(Guild.Id, WrappedPoster.ModuleId);
        if (!_enabled)
        {
            _cards = [];
            return;
        }

        IReadOnlyList<WrappedCard> cards = _view switch
        {
            "server" => await Wrapped.ServerAsync(Guild, _period, WrappedNames.Mark),
            "me" => await Wrapped.MemberAsync(Guild, Member.Id, "Your", _period, WrappedNames.Mark),
            _ => await Wrapped.VoiceAsync(Guild, _view, _period, WrappedNames.Mark) is { } voice ? [voice] : [],
        };
        _cards = [.. await Task.WhenAll(cards.Select(c => Names.FillAsync(Guild.Id, c)))];
    }

    private async Task SetInAsync()
    {
        if (!Ready)
            return;
        var include = Posted("in") == "True";
        await Wrapped.SetInAsync(Guild.Id, Member.Id, include);
        _message = include ? "You're named in this server's Wrapped now." : "You're no longer named in this server's Wrapped.";
        await LoadAsync();
    }

    private static string Label(WrappedPeriod period) => period switch
    {
        WrappedPeriod.ThisMonth => "This month",
        WrappedPeriod.LastMonth => "Last month",
        WrappedPeriod.ThisYear => "This year",
        WrappedPeriod.LastYear => "Last year",
        _ => "All time",
    };
}
