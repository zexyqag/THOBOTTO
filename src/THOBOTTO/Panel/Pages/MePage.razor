@page "/g/{GuildId:long}/me"
@attribute [Authorize]
@inherits GuildPage
@using System.Text.RegularExpressions
@using NodaTime
@using THOBOTTO.Debugging
@using THOBOTTO.Events
@using THOBOTTO.Helpers
@using THOBOTTO.Integrations
@using THOBOTTO.Members
@using THOBOTTO.Music
@using THOBOTTO.Notifications
@using THOBOTTO.Sounds
@using THOBOTTO.Steam
@using THOBOTTO.Voice.Hearing
@using THOBOTTO.Wrapped
@inject TimeZones Zones
@inject Notifier Notifier
@inject TimeProvider Time
@inject Scrobbler Scrobbler
@inject SoundBoard Sounds
@inject WrappedService Wrapped
@inject VoicePrefs VoicePrefs
@inject VoiceTrace Trace
@inject SettingsStore Settings
@inject ModuleState Modules
@inject IEnumerable<IMemberData> Data
@inject CalendarLinks Calendars
@inject SteamClient SteamApi
@inject SteamLibrary SteamGames
@inject IntegrationStore Integrations
@inject PanelLinks Links

<PageTitle>You · THOBOTTO</PageTitle>

@if (!Ready)
{
    <p class="muted">You aren't in that server, or the bot isn't.</p>
}
else
{
    <GuildNav Guild="Guild" Current="me" />
    <h1>You</h1>
    @if (_message is not null)
    {
        <p class="notice @(_failed ? "bad" : "good")">@_message</p>
    }
    <form method="post" @formname="me" @onsubmit="SaveAsync">
        <AntiforgeryToken />
        <section class="card">
            <h2>Time zone</h2>
            <p>
                The times you type for events and sessions are read in <strong>@_zone!.Id</strong>
                (it's @Now(_zone) there)@(_own ? "." : ", the server's; you haven't set your own.")
                It's the same in every server.
            </p>
            <p class="row" data-browser-zone="@_zone.Id" hidden>
                <input type="hidden" name="browser-zone" />
                Your browser says <strong class="zone"></strong>.
                <button class="button small" name="act" value="browser">Use that</button>
            </p>
            <div class="row">
                <input name="zone" list="zones" placeholder="Or pick one: start typing a city" class="grow" aria-label="Time zone" />
                <button class="button small secondary" name="act" value="zone">Set</button>
                @if (_own)
                {
                    <button class="button small secondary" name="act" value="server-zone">Use the server's</button>
                }
            </div>
            <datalist id="zones">
                @foreach (var id in TimeZones.Ids)
                {
                    <option value="@id"></option>
                }
            </datalist>
        </section>

        <section class="card">
            <h2>DMs from the bot</h2>
            <p class="muted">What the bot tells you about in a direct message, in this server.</p>
            @foreach (var topic in _topics)
            {
                <div class="field">
                    <label class="check"><input type="checkbox" name="topic" value="@topic.Id" checked="@_subscribed.Contains(topic.Id)" /> @topic.Description</label>
                </div>
            }
            <button class="button small" name="act" value="dms">Save DMs</button>
        </section>

        @if (_listeningOn || _musicJoinAllowed)
        {
            <section class="card">
                <h2>Voice</h2>
                @if (_listeningOn && Trace.On(Guild!.Id))
                {
                    <p class="notice">🔧 Voice debugging is on here: what the helpers hear you say, and what they make of it, is shown to the server's admins on its Debug page (kept in memory only, until it's turned off).</p>
                }
                @if (_listeningOn)
                {
                    <p class="muted">
                        Say a helper's name and what to do: "Jeeves, play Thunderstruck", "skip", "pause", "what's playing". A helper listens where
                        you summon it with <code>/listen</code>@(_autoListenAllowed ? ", or wherever you are if you let it join you" : ""). It only ever hears members who
                        switch this on, and keeps nothing that's said: the last couple of minutes stay in memory only, so
                        "Jeeves, quote that" can save a line as a quote.
                    </p>
                    <div class="row">
                        <button class="toggle @(_voice.Listen ? "on" : "off")" name="act" value="voice-listen">@(_voice.Listen ? "Helpers hear me" : "Helpers don't hear me")</button>
                        @if (_voice.Listen)
                        {
                            <button class="toggle @(_voice.QuotesOff ? "off" : "on")" name="act" value="voice-quotable">@(_voice.QuotesOff ? "Others can't quote what I say" : "Others can quote what I say")</button>
                        }
                        @if (_autoListenAllowed && _voice.Listen)
                        {
                            <button class="toggle @(_voice.AutoListen ? "on" : "off")" name="act" value="voice-autolisten">@(_voice.AutoListen ? "A helper joins me to listen" : "Only when I summon one")</button>
                        }
                    </div>
                }
                @if (_musicJoinAllowed)
                {
                    <p class="muted">A free helper can join your voice channel whenever you're in one, ready for <code>/play</code> or a voice command.</p>
                    <button class="toggle @(_voice.AutoMusic ? "on" : "off")" name="act" value="voice-automusic">@(_voice.AutoMusic ? "A helper joins me for music" : "No music helper joins me")</button>
                }
            </section>
        }
        @if (_soundsOn)
        {
            <section class="card">
                <h2>Your join sounds</h2>
                <p class="muted">One plays when you join a voice channel here; with several, one at random. The sounds themselves are on the <a href="/g/@Guild.Id/sounds">Sounds</a> page.</p>
                @if (_joins.Count > 0)
                {
                    <ul class="plain">
                        @foreach (var join in _joins)
                        {
                            <li>@join.Name <button class="link" name="act" value="join-off|@join.Id">remove</button></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="muted">You have none.</p>
                }
                @if (_library.Count == 0)
                {
                    <p class="muted">The library is empty so far.</p>
                }
                else
                {
                    <div class="row">
                        <select name="sound" aria-label="Join sound">
                            @foreach (var sound in _library.Where(s => _joins.All(j => j.Id != s.Id)))
                            {
                                <option value="@sound.Id">@sound.Name</option>
                            }
                        </select>
                        <button class="button small secondary" name="act" value="join">Add as a join sound</button>
                        @if (_joins.Count > 1)
                        {
                            <button class="button small secondary" name="act" value="join-off">No join sounds</button>
                        }
                    </div>
                }
            </section>
        }
        @if (_calendar is var (calendarHttps, calendarWebcal))
        {
            <section class="card">
                <h2>Your calendar</h2>
                <p class="muted">Events from your servers in your own calendar app, kept up to date: subscribe to this link (Google Calendar: Other calendars → From URL; Apple: <a href="@calendarWebcal">open it</a>). It's yours, so keep it to yourself. Events you're in for are marked ✅, maybes 🤔.</p>
                <p><code>@calendarHttps</code></p>
                <div class="row">
                    <select name="calendar-choice" aria-label="From this server">
                        @foreach (var (value, label) in CalendarChoices.All)
                        {
                            <option value="@value" selected="@(value == _calendarChoice)">@label</option>
                        }
                    </select>
                    <select name="calendar-reminder" aria-label="Reminders">
                        @foreach (var (minutes, label) in CalendarReminders.All)
                        {
                            <option value="@minutes" selected="@(minutes == _calendarReminder)">@label</option>
                        }
                    </select>
                    <button class="button small" name="act" value="calendar-choice">Save</button>
                    <button class="link" name="act" value="calendar-renew">New link</button>
                </div>
                <small class="muted">What it shows from this server (each server's You page has its own), and a reminder before the events you're in for, which Apple's and Outlook's calendars keep (Google's doesn't, for subscribed calendars). A new link makes the old one stop working.</small>
            </section>
        }
        <section class="card">
            <h2>Your name in Wrapped</h2>
            <p class="muted">Everyone's listening counts in this server's totals. Only members who opt in are named in rankings like top DJs and listening buddies, for everything they've done here, also from before they opted in. Your own Wrapped is always yours to see: <a href="/g/@Guild.Id/wrapped">see your Wrapped</a>.</p>
            <button class="toggle @(_wrappedIn ? "on" : "off")" name="act" value="wrapped-@(_wrappedIn ? "out" : "in")">@(_wrappedIn ? "Named in Wrapped" : "Not named in Wrapped")</button>
        </section>
        @if (Scrobbler.Configured)
        {
            <section class="card">
                <h2>Last.fm</h2>
                @if (_lastfm is { } link)
                {
                    <p>
                        @(link.Scrobbling ? "Scrobbling to" : "Linked to, paused:")
                        <a href="https://www.last.fm/user/@Uri.EscapeDataString(link.Username)" target="_blank" rel="noopener">@link.Username</a>
                    </p>
                    <p class="muted">What the helpers play is scrobbled while you're in the voice channel and not deafened, in every server. A track counts once you've heard half of it (or 4 minutes), from the start.</p>
                    <div class="row">
                        <button class="button small secondary" name="act" value="@(link.Scrobbling ? "lastfm-pause" : "lastfm-resume")">@(link.Scrobbling ? "Pause scrobbling" : "Resume scrobbling")</button>
                        <button class="button small danger" name="act" value="lastfm-unlink">Disconnect</button>
                    </div>
                }
                else
                {
                    <p class="muted">Link your Last.fm account and what you listen to with the helpers shows up there, in every server.</p>
                    <a class="button small" href="/lastfm/connect?back=@Uri.EscapeDataString($"/g/{Guild.Id}/me")">Connect Last.fm</a>
                }
            </section>
        }
        @if (SteamApi.Configured)
        {
            <section class="card">
                <h2>Steam</h2>
                @if (_steam is { } steam)
                {
                    <p>Linked to <a href="https://steamcommunity.com/profiles/@steam.SteamId" target="_blank" rel="noopener">@steam.Name</a></p>
                    @if (steam.Hidden)
                    {
                        <p class="notice bad">Your game details are private on Steam, so nobody sees your games. To share them: on Steam, your profile → Edit Profile → Privacy Settings → Game details: Public; then Read again.</p>
                    }
                    else if (steam.ReadAt is null)
                    {
                        <p class="muted">Your games haven't been read yet; they are within the hour.</p>
                    }
                    else
                    {
                        <p class="muted">@_steamGames games. Members of servers with Steam on see which you own and how long you've played (<code>/steam owns</code>, <code>/steam common</code>). They're read again each day.</p>
                    }
                    <div class="row">
                        <button class="button small secondary" name="act" value="steam-read">Read again</button>
                        <button class="button small danger" name="act" value="steam-unlink">Disconnect</button>
                    </div>
                }
                else
                {
                    <p class="muted">Link your Steam account, and members of servers with Steam on see which games you own: who has a game when planning, and what everyone in a voice channel can play together. Your game details have to be public on Steam.</p>
                    <div class="row">
                        <a class="button small" href="/steam/connect?back=@Uri.EscapeDataString($"/g/{Guild.Id}/me")">Sign in through Steam</a>
                        @if (_steamFromDiscord)
                        {
                            <a class="button small secondary" href="/login/for/@SteamFromDiscord.Purpose?back=@Uri.EscapeDataString($"/g/{Guild.Id}/me")">Use the Steam account on my Discord profile</a>
                        }
                    </div>
                }
            </section>
        }
        <section class="card">
            <h2>What you can do here</h2>
            @if (_permissions.Count == 0)
            {
                <p class="muted">No bot permissions: the everyday commands are yours, the rest is for the server's admins.</p>
            }
            else
            {
                <ul class="links">
                    @foreach (var (permission, source) in _permissions)
                    {
                        <li><code>@permission</code> <small class="muted">via @Strip(source)</small></li>
                    }
                </ul>
            }
        </section>
        <section class="card">
            <h2>Your data</h2>
            <p class="muted">
                The records the bot keeps of yours in this server. They're part of the server's history and stay when you leave, but for Named in Wrapped, an opt-in that ends then; your DM topics, voice preferences and join sound go with you too.
                Your time zone and Last.fm link are yours in every server.
                <a href="/g/@Guild.Id/me/data">Download</a> all of the records as a JSON file.
            </p>
            <ul class="links">
                @foreach (var (name, count) in _data)
                {
                    <li>@name <strong>@count</strong></li>
                }
            </ul>
        </section>
    </form>
}

@code {
    private DateTimeZone? _zone;
    private bool _own;
    private IReadOnlyList<NotificationTopic> _topics = [];
    private IReadOnlySet<string> _subscribed = new HashSet<string>();
    private IReadOnlyList<(string Permission, string Source)> _permissions = [];
    private LastfmLink? _lastfm;
    private SteamLink? _steam;
    private int _steamGames;
    private bool _steamFromDiscord;
    private bool _wrappedIn;
    private (string Https, string Webcal)? _calendar;
    private string _calendarChoice = CalendarChoices.Everything;
    private int? _calendarReminder;
    private bool _soundsOn;
    private IReadOnlyList<Sound> _library = [];
    private IReadOnlyList<Sound> _joins = [];
    private bool _listeningOn;
    private bool _autoListenAllowed;
    private bool _musicJoinAllowed;
    private VoicePreference _voice = new();
    private IReadOnlyList<(string Name, long Count)> _data = [];
    private string? _message;
    private bool _failed;

    protected override async Task LoadAsync()
    {
        (_zone, _own) = await Zones.ForAsync(Guild!.Id, Member!.Id);
        _topics = await Notifier.TopicsAsync(Guild.Id);
        _subscribed = await Notifier.SubscriptionsAsync(Guild.Id, Member.Id);
        _permissions = await Access.Control.ExplainAsync(Guild, Member);
        _lastfm = await Scrobbler.FindAsync(Member.Id);
        _steam = await SteamGames.FindAsync(Member.Id);
        _steamGames = _steam is null ? 0 : await SteamGames.CountAsync(Member.Id);
        _steamFromDiscord = await DiscordLogin.AvailableAsync(Integrations, Links);
        _wrappedIn = await Wrapped.IsInAsync(Guild.Id, Member.Id);
        var calendar = await Calendars.MemberLinkAsync(Member.Id);
        (_calendar, _calendarChoice, _calendarReminder) = (await Calendars.AddressOfAsync(calendar), CalendarLinks.ChoiceIn(calendar, Guild.Id), calendar.ReminderMinutes);
        _soundsOn = await Modules.IsEnabledAsync(Guild.Id, SoundBoard.ModuleId);
        if (_soundsOn)
        {
            _library = await Sounds.LibraryAsync(Guild.Id);
            _joins = await Sounds.JoinSoundsOfAsync(Guild.Id, Member.Id);
        }
        _listeningOn = await Modules.IsEnabledAsync(Guild.Id, VoiceEars.ModuleId);
        _autoListenAllowed = (await Settings.GetAsync<ListeningRules>(Guild.Id, VoiceEars.ModuleId)).AutoListenAllowed;
        _musicJoinAllowed = await Modules.IsEnabledAsync(Guild.Id, MusicService.ModuleId)
            && (await Settings.GetAsync<MusicRules>(Guild.Id, MusicService.ModuleId)).AutoJoinAllowed;
        _voice = await VoicePrefs.GetAsync(Guild.Id, Member.Id);
        var data = new List<(string Name, long Count)>();
        foreach (var source in Data.OrderBy(s => s.Name))
            data.Add((source.Name, await source.CountAsync(Guild.Id, Member.Id)));
        _data = data;
        if (_message is null && Query("lastfm") is { Length: > 0 } outcome)
            (_message, _failed) = outcome == "linked" ? ($"Linked to Last.fm as {_lastfm?.Username}.", false) : ("Linking Last.fm didn't work; try again.", true);
        if (_message is null && Query("steam") is { Length: > 0 } signedIn)
            (_message, _failed) = signedIn switch
            {
                "linked" => ($"Linked to Steam as {_steam?.Name}.", false),
                "unread" => ("Linked to Steam; your games couldn't be read just now, so they're read within the hour.", false),
                "none" => ("Your Discord profile has no verified Steam account: connect one in Discord (User Settings → Connections), or sign in through Steam.", true),
                "other" => ("That was another Discord account than the one logged in here.", true),
                _ => ("Linking Steam didn't work; try again.", true),
            };
    }

    private async Task SaveAsync()
    {
        if (!Ready)
            return;
        _failed = false;
        switch (Posted("act"))
        {
            case "calendar-choice" when CalendarChoices.All.Any(c => c.Value == Posted("calendar-choice")):
                await Calendars.SetChoiceAsync(Member!.Id, Guild.Id, Posted("calendar-choice"));
                await Calendars.SetReminderAsync(Member.Id, int.TryParse(Posted("calendar-reminder"), out var reminder) && CalendarReminders.All.Any(r => r.Minutes == reminder) ? reminder : null);
                _message = "Saved; calendar apps pick it up at their next look (within a few hours for Google).";
                break;
            case "calendar-renew":
                await Calendars.MemberLinkAsync(Member!.Id, renew: true);
                _message = "Your calendar link is new; the old one stopped working.";
                break;
            case "browser" or "zone":
                var asked = Posted(Posted("act") == "browser" ? "browser-zone" : "zone").Trim();
                if (TimeZones.Find(asked) is { } zone)
                {
                    await Zones.SetAsync(Member!.Id, zone.Id);
                    _message = $"Your time zone is {zone.Id} now.";
                }
                else
                    (_message, _failed) = ("That isn't a time zone I know; pick one from the list.", true);
                break;
            case "lastfm-pause" or "lastfm-resume":
                await Scrobbler.SetScrobblingAsync(Member!.Id, Posted("act") == "lastfm-resume");
                _message = Posted("act") == "lastfm-resume" ? "Scrobbling again." : "Scrobbling paused.";
                break;
            case "voice-listen":
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => (p.Listen, p.AutoListen) = (!p.Listen, false));
                _message = "Saved.";
                break;
            case "voice-autolisten" when _autoListenAllowed:
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => p.AutoListen = p.Listen && !p.AutoListen);
                _message = "Saved.";
                break;
            case "voice-quotable":
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => p.QuotesOff = !p.QuotesOff);
                _message = "Saved.";
                break;
            case "voice-automusic" when _musicJoinAllowed:
                await VoicePrefs.SetAsync(Guild.Id, Member!.Id, p => p.AutoMusic = !p.AutoMusic);
                _message = "Saved.";
                break;
            case "wrapped-in" or "wrapped-out":
                await Wrapped.SetInAsync(Guild.Id, Member!.Id, Posted("act") == "wrapped-in");
                _message = Posted("act") == "wrapped-in" ? "You're named in this server's Wrapped now." : "You're no longer named in this server's Wrapped.";
                break;
            case "join" when _soundsOn && _library.FirstOrDefault(s => s.Id.ToString() == Posted("sound")) is { } sound:
                _message = await Sounds.ToggleJoinSoundAsync(Guild.Id, Member!.Id, sound.Name);
                _failed = _message.StartsWith("There's");
                break;
            case "join" when _soundsOn:
                (_message, _failed) = ("That sound is gone; try again.", true);
                break;
            case var act when _soundsOn && act.StartsWith("join-off|") && _joins.FirstOrDefault(j => j.Id.ToString() == act["join-off|".Length..]) is { } off:
                _message = await Sounds.ToggleJoinSoundAsync(Guild.Id, Member!.Id, off.Name);
                break;
            case "join-off" when _soundsOn:
                _message = await Sounds.ClearJoinSoundsAsync(Guild.Id, Member!.Id);
                break;
            case "steam-read":
                (_message, _failed) = await SteamGames.ReadAsync(Member!.Id) is { } problem ? (problem, true) : ("Read your Steam games again.", false);
                break;
            case "steam-unlink":
                await SteamGames.UnlinkAsync(Member!.Id);
                _message = "Steam disconnected: your games aren't shown any more, in any server.";
                break;
            case "lastfm-unlink":
                await Scrobbler.UnlinkAsync(Member!.Id);
                _message = "Last.fm disconnected. You can also remove THOBOTTO from your Last.fm applications.";
                break;
            case "server-zone":
                await Zones.ClearAsync(Member!.Id);
                _message = "You follow the server's time zone now.";
                break;
            case "dms":
                var wanted = HttpContext.Request.Form["topic"].Select(t => t ?? "").ToHashSet();
                foreach (var topic in _topics)
                {
                    if (wanted.Contains(topic.Id) != _subscribed.Contains(topic.Id))
                        await Notifier.SetAsync(Guild.Id, Member!.Id, topic.Id, wanted.Contains(topic.Id));
                }
                _message = "Saved.";
                break;
        }
        await LoadAsync();
    }

    private string Now(DateTimeZone zone) => Instant.FromDateTimeOffset(Time.GetUtcNow()).InZone(zone).ToString("HH:mm, ddd d MMM", null);

    // Explanations name roles as Discord mentions; here they read as role names.
    private string Strip(string source) => Regex.Replace(source, @"<@&(\d+)>",
        m => Guild!.Roles.TryGetValue(ulong.Parse(m.Groups[1].Value), out var role) ? role.Name : "a deleted role");
}
