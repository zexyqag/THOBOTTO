@page "/g/{GuildId:long}/emoji"
@attribute [Authorize]
@inherits GuildPage
@inject ExpressionShelf Shelf
@inject ModuleState Modules
@inject SettingsStore Settings
@inject PanelNames Names
@using THOBOTTO.Discord

<PageTitle>Emoji · THOBOTTO</PageTitle>

@if (!Ready)
{
    <p class="muted">You aren't in that server, or the bot isn't.</p>
}
else
{
    <GuildNav Guild="Guild" Current="emoji" />
    <h1>Emoji and stickers</h1>
    @if (!_on)
    {
        <p class="muted">@ModuleRegistry.Off(ExpressionShelf.ModuleId)</p>
    }
    else
    {
        @if (_message is not null)
        {
            <p class="notice @(_failed ? "bad" : "good")">@_message</p>
        }
        <form method="post" enctype="multipart/form-data" @formname="emoji" @onsubmit="ActAsync">
            <AntiforgeryToken />
            <section class="card">
                <h2>Propose one</h2>
                <p class="muted">It goes up for a vote here and in the happenings forum (when it shows proposals); proposing costs @_rules.ProposeCost.ToString("0.#") points, refunded if accepted.</p>
                <div class="row">
                    <select name="kind" aria-label="Kind">
                        <option value="@ExpressionKinds.Emoji">Emoji</option>
                        <option value="@ExpressionKinds.Sticker">Sticker</option>
                    </select>
                    <input name="name" maxlength="32" placeholder="Name" aria-label="Name" />
                    <input name="tag" maxlength="32" placeholder="Sticker tag (an emoji)" aria-label="Sticker tag" />
                </div>
                <div class="field">
                    <label for="file">Image</label>
                    <input id="file" name="file" type="file" accept="image/png,image/jpeg,image/gif,image/webp" />
                    <small class="muted">Emojis: PNG, JPEG, GIF or WebP up to 256 KB. Stickers: PNG, APNG or GIF up to 512 KB, with an emoji as their tag.</small>
                </div>
                <button class="button small" name="act" value="propose">Propose</button>
            </section>

            @if (_voting.Count > 0)
            {
                <section class="card wide-list">
                    <h2>Up for a vote</h2>
                    <table>
                        @foreach (var e in _voting)
                        {
                            var votes = _votes.GetValueOrDefault(e.Id);
                            <tr>
                                <td><img class="emoji" src="/g/@Guild.Id/emoji/@e.Id/image" alt="@e.Name" /></td>
                                <td><strong>@Label(e)</strong><br /><span class="muted">by @_names.GetValueOrDefault(e.ProposerId, "someone") · @(_rules.DownVotes ? $"👍 {votes.Ups} · 👎 {votes.Downs}" : $"👍 {votes.Ups}") · until <When At="e.VoteEndsAt" /></span></td>
                                <td>
                                    <span class="row">
                                        <button class="link" name="act" value="up|@e.Id">👍</button>
                                        @if (_rules.DownVotes)
                                        {
                                            <button class="link" name="act" value="down|@e.Id">👎</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </table>
                </section>
            }

            <section class="card wide-list">
                <h2>Library</h2>
                @if (_live.Count == 0)
                {
                    <p class="muted">None yet.</p>
                }
                <table>
                    @foreach (var e in _live)
                    {
                        <tr>
                            <td><img class="emoji" src="/g/@Guild.Id/emoji/@e.Id/image" alt="@e.Name" /></td>
                            <td><strong>@Label(e)</strong>@Mark(e)<br /><span class="muted">made by @_names.GetValueOrDefault(e.CreatorId, "someone") · @e.Uses @(e.Uses == 1 ? "use" : "uses")@(e.Adopted ? " · uploaded on Discord" : "")@(e.DiscordRemovedAt is { } off ? $" · taken off Discord {off:MMM d}" : "")</span></td>
                            <td>
                                @if (_canManage)
                                {
                                    <span class="row">
                                        @if (e.DiscordId is not null)
                                        {
                                            <button class="link" name="act" value="@(e.Pinned ? "unpin" : "pin")|@e.Id">@(e.Pinned ? "Unpin" : "Pin")</button>
                                            <button class="link" name="act" value="off|@e.Id">Take off Discord</button>
                                        }
                                        else
                                        {
                                            <button class="link" name="act" value="pin|@e.Id">Put on Discord</button>
                                        }
                                        <button class="link" name="act" value="retire|@e.Id">Retire</button>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </table>
                <small class="muted">😀 on Discord's list, 📌 pinned there@(_rules.EmojiList == EmojiListChoices.MostUsed ? " (the other slots go to the most used)" : ""); the other emoji members use with <code>:name:</code> (posted again under their name) or right-click → Apps → React with emoji, and the other stickers with <code>/sticker send</code> or <code>sticker:name</code>. Royalties: @_rules.RoyaltyPerUse.ToString("0.##") points to the maker each time someone else uses one, at most @_rules.RoyaltyDailyCap.ToString("0.#") a day.</small>
            </section>

            @foreach (var (heading, view) in _views.Where(v => v.View.Ranking.Count > 0))
            {
                <section class="card">
                    <h2>@heading by uses</h2>
                    <p class="muted">What the most-used policy goes by: uses in the last @view.Days days, on Discord's list and through the bot alike. Discord's list holds @view.Used of @view.Slots; @view.SwapsLeft of @view.SwapsPerDay swaps left today. Pinned ones stay, new ones get a trial, then the most used fill the rest, and one replaces the least used only with clearly more uses.</p>
                    <ol>
                        @foreach (var ranked in view.Ranking.Take(MostRanked))
                        {
                            <li>@ranked.Name <span class="muted">· @ranked.Item.Uses @(ranked.Item.Uses == 1 ? "use" : "uses")@Marks(ranked.Item)</span></li>
                        }
                    </ol>
                    @if (view.Ranking.Count > MostRanked)
                    {
                        <small class="muted">And @(view.Ranking.Count - MostRanked) more, used less.</small>
                    }
                </section>
            }

            @if (_retired.Count > 0)
            {
                <section class="card wide-list">
                    <h2>Retired</h2>
                    <table>
                        @foreach (var e in _retired)
                        {
                            <tr>
                                <td><img class="emoji" src="/g/@Guild.Id/emoji/@e.Id/image" alt="@e.Name" /></td>
                                <td><strong>@Label(e)</strong><br /><span class="muted">made by @_names.GetValueOrDefault(e.CreatorId, "someone")@if (e.RetiredAt is { } at)
                                {
                                    <text> · retired </text><When At="at" />
                                }</span></td>
                                <td><button class="link" name="act" value="revive|@e.Id">Revive</button></td>
                            </tr>
                        }
                    </table>
                    <small class="muted">Reviving puts it up for a vote again, here and in the happenings forum (when it shows proposals); it costs @_rules.ProposeCost.ToString("0.#") points, refunded if accepted.</small>
                </section>
            }
        </form>
    }
}

@code {

    private const int MostRanked = 30;

    private bool _on;
    private bool _canManage;
    private IReadOnlyList<(string Heading, SlotView View)> _views = [];
    private ExpressionRules _rules = new();
    private IReadOnlyList<Expression> _voting = [];
    private IReadOnlyList<Expression> _live = [];
    private IReadOnlyList<Expression> _retired = [];
    private IReadOnlyDictionary<long, (int Ups, int Downs)> _votes = new Dictionary<long, (int, int)>();
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private string? _message;
    private bool _failed;

    private static string Label(Expression e) => e.Kind == ExpressionKinds.Emoji ? $":{e.Name}:" : $"Sticker: {e.Name}";

    private static string Mark(Expression e) => e.DiscordId is null ? "" : e.Pinned ? " 📌" : " 😀";

    private static string Marks(SlotItem emoji)
        => (emoji.Pinned ? " · pinned" : emoji.OnDiscord ? " · on Discord" : "")
            + (emoji.Trial ? " · on trial" : "")
            + (!emoji.Wanted ? " · taken off Discord by hand" : "");

    protected override async Task LoadAsync()
    {
        _on = await Modules.IsEnabledAsync(Guild!.Id, ExpressionShelf.ModuleId);
        _rules = await Settings.GetAsync<ExpressionRules>(Guild.Id, ExpressionShelf.ModuleId);
        _canManage = await CanAsync(BotPermissions.ManageExpressions);
        _views = _rules.EmojiList == EmojiListChoices.MostUsed
            ? [("Emoji", await Shelf.LibraryViewAsync(Guild.Id, ExpressionKinds.Emoji)), ("Stickers", await Shelf.LibraryViewAsync(Guild.Id, ExpressionKinds.Sticker))]
            : [];
        var all = await Shelf.ListAsync(Guild.Id);
        _voting = all.Where(e => e.State == ExpressionStates.Voting).OrderBy(e => e.VoteEndsAt).ToList();
        _live = all.Where(e => e.State == ExpressionStates.Live).ToList();
        _retired = all.Where(e => e.State == ExpressionStates.Retired).OrderByDescending(e => e.RetiredAt).ToList();
        _votes = await Shelf.VotesAsync(Guild.Id);
        _names = await Names.NamesAsync(Guild.Id, all.Select(e => e.ProposerId).Concat(all.Select(e => e.CreatorId)).Distinct());
    }

    private async Task ActAsync()
    {
        if (!Ready || !_on)
            return;
        var act = Posted("act").Split('|');
        _message = act switch
        {
            ["propose"] => await ProposeAsync(),
            ["up" or "down", var id] when long.TryParse(id, out var voteId) => await Shelf.VoteAsync(voteId, Member!.Id, act[0] == "up"),
            ["revive", var id] when long.TryParse(id, out var reviveId) => _retired.FirstOrDefault(e => e.Id == reviveId) is { } e
                ? await Shelf.ReviveAsync(Guild!.Id, e.Kind, e.Name, Member!.Id, null)
                : "That one isn't retired anymore.",
            ["pin" or "unpin", var id] when _canManage && long.TryParse(id, out var pinId) => await Shelf.PinAsync(Guild!.Id, pinId, act[0] == "pin"),
            ["off", var id] when _canManage && long.TryParse(id, out var offId) => await Shelf.TakeOffAsync(Guild!.Id, offId),
            ["retire", var id] when _canManage && long.TryParse(id, out var retireId) => await Shelf.RetireAsync(Guild!.Id, retireId),
            _ => "That isn't something I can do.",
        };
        _failed = !_message.StartsWith("Your") && !_message.StartsWith("Voted") && !_message.StartsWith(':');
        await LoadAsync();
    }

    private async Task<string> ProposeAsync()
    {
        if (HttpContext.Request.Form.Files["file"] is not { Length: > 0 } file)
            return "Pick an image first.";
        if (file.Length > 1024 * 1024)
            return "That file is too big for an emoji or a sticker.";
        using var stream = new MemoryStream();
        await file.CopyToAsync(stream);
        var kind = Posted("kind") == ExpressionKinds.Sticker ? ExpressionKinds.Sticker : ExpressionKinds.Emoji;
        var tag = Posted("tag").Trim() is { Length: > 0 } t ? t : null;
        return await Shelf.ProposeAsync(Guild!.Id, kind, Posted("name").Trim(), tag, Member!.Id, stream.ToArray(), file.ContentType, null);
    }
}
