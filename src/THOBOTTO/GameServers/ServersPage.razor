@page "/g/{GuildId:long}/servers"
@attribute [Authorize]
@inherits GuildPage
@using Microsoft.EntityFrameworkCore
@using THOBOTTO.Data
@using THOBOTTO.Overview
@inject ServerWatch Watch
@inject GameDig GameDig
@inject ModuleState Modules
@inject IDbContextFactory<BotDbContext> DbFactory
@inject PanelNames Names
@inject OverviewBoard Overview
@inject ServerDetails Passwords
@inject ServerControl Control

<PageTitle>Game servers · THOBOTTO</PageTitle>

@if (!Ready)
{
    <p class="muted">You aren't in that server, or the bot isn't.</p>
}
else
{
    <GuildNav Guild="Guild" Current="servers" />
    <h1>Game servers</h1>
    @if (!_on)
    {
        <p class="muted">@ModuleRegistry.Off(ServerWatch.ModuleId)</p>
    }
    else
    {
        @if (_message is not null)
        {
            <p class="notice @(_failed ? "bad" : "good")">@_message</p>
        }
        <form method="post" @formname="servers" @onsubmit="ActAsync">
            <AntiforgeryToken />
            <section class="card wide-list">
                <h2>Checked every @_settings.PollSeconds seconds</h2>
                <p class="muted">@(_shown ? "Shown in Discord by the Game servers block of an overview widget." : "No overview widget shows them in Discord yet: add the Game servers block on the Overview page.")</p>
                @if (_servers.Count == 0)
                {
                    <p class="muted">None yet.</p>
                }
                <table>
                    @foreach (var server in _servers)
                    {
                        var status = Watch.LastStatus(server.Id);
                        <tr>
                            <td><strong>@(server.Name ?? status?.Name ?? server.Game)</strong><br /><span class="muted">@_gameNames.GetValueOrDefault(server.Game, server.Game) · <code>@server.Address</code> · by @_names.GetValueOrDefault(server.OwnerId, "someone")</span></td>
                            <td>@(status is null ? "offline" : $"{status.Players}/{status.MaxPlayers} playing{(status.Map is { } map ? $" on {map}" : "")}{(status.Password ? " · password" : "")}")</td>
                            <td>
                                @if (_canManage || server.OwnerId == Member!.Id)
                                {
                                    <button class="link" name="act" value="remove|@server.Id">Remove</button>
                                }
                            </td>
                        </tr>
                        @if (server.Modpack is not null || server.Note is not null || server.Password is not null || server.JoinAddress is not null)
                        {
                            <tr class="muted">
                                <td colspan="3">@About(server)</td>
                            </tr>
                        }
                        @if (_canManage || server.OwnerId == Member!.Id)
                        {
                            <tr>
                                <td colspan="3">
                                    <details>
                                        <summary class="muted">Edit</summary>
                                        <div class="row">
                                            <input name="name-@server.Id" value="@server.Name" maxlength="@ServerDetails.NameLength" placeholder="Name to show" aria-label="Name" />
                                            <input name="join-@server.Id" value="@server.JoinAddress" maxlength="@ServerDetails.AddressLength" placeholder="Join address (if not @server.Address)" aria-label="Join address" />
                                        </div>
                                        <div class="row">
                                            <input name="modpack-@server.Id" value="@server.Modpack" maxlength="@ServerDetails.ModpackLength" placeholder="Modpack" aria-label="Modpack" />
                                            <input name="version-@server.Id" value="@server.ModpackVersion" maxlength="@ServerDetails.VersionLength" placeholder="Version" aria-label="Modpack version" />
                                            <input name="link-@server.Id" value="@server.ModpackLink" maxlength="@ServerDetails.LinkLength" placeholder="Link (https://…)" aria-label="Modpack link" />
                                        </div>
                                        <div class="row">
                                            <input name="note-@server.Id" value="@server.Note" maxlength="@ServerDetails.NoteLength" placeholder="A note for players" aria-label="Note" />
                                        </div>
                                        <div class="row">
                                            <input name="password-@server.Id" value="@Passwords.PasswordOf(server)" maxlength="@ServerDetails.PasswordLength" placeholder="Password" aria-label="Password" autocomplete="off" />
                                            <select name="for-@server.Id" aria-label="Who gets the password">
                                                <option value="@PasswordShown.Card" selected="@(server.PasswordFor == PasswordShown.Card)">Shown on its card</option>
                                                <option value="@PasswordShown.Anyone" selected="@(server.PasswordFor == PasswordShown.Anyone)">Anyone, privately with the card's button</option>
                                                @foreach (var role in Roles())
                                                {
                                                    <option value="role:@role.Id" selected="@(server.PasswordFor == PasswordShown.Role && server.PasswordRoleId == role.Id)">@@@role.Name's members, privately with the button</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="row">
                                            <input name="rcon-@server.Id" value="@server.RconAddress" maxlength="@ServerDetails.AddressLength" placeholder="Remote control (RCON): host:port" aria-label="RCON address" autocomplete="off" />
                                            <input name="rcon-password-@server.Id" type="password" maxlength="@ServerDetails.PasswordLength" placeholder="@(server.RconPassword is null ? "RCON password" : "RCON password set (type to replace)")" aria-label="RCON password" autocomplete="new-password" />
                                            <label class="check"><input type="checkbox" name="announce-@server.Id" value="true" checked="@server.AnnounceSessions" /> Announce sessions in the game</label>
                                        </div>
                                        <small class="muted">Remote control lets <code>/servers console</code> run commands (for those with @BotPermissions.GameServerConsole) and announces the game's sessions in the game @(ServerControl.Say(server.Game, "") is null ? "(not for this game yet)" : "(the reminder and the start)"). An address inside the bot's own network, like a container's name, only the bot's owner can set.</small>
                                        <div class="row">
                                            <button class="button small" name="act" value="edit|@server.Id">Save</button>
                                        </div>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </section>

            @if (_canAdd)
            {
                <section class="card">
                    <h2>Add one</h2>
                    <div class="row">
                        <select name="game" aria-label="Game">
                            @foreach (var game in _gameNames.OrderBy(g => g.Value))
                            {
                                <option value="@game.Key">@game.Value</option>
                            }
                        </select>
                        <input name="address" maxlength="200" placeholder="host or host:port" aria-label="Address" />
                        <input name="name" maxlength="100" placeholder="Name to show (optional)" aria-label="Name" />
                        <button class="button small" name="act" value="add">Add</button>
                    </div>
                    <small class="muted">Leave the port out for the game's default. This server takes at most @_settings.MaxServers@(_canManage ? "" : $", {_settings.MaxPerMember} of them yours").</small>
                </section>
            }
        </form>
    }
}

@code {
    private bool _on;
    private bool _canManage;
    private bool _canAdd;
    private bool _shown;
    private ServerSettings _settings = new();
    private IReadOnlyList<GameServer> _servers = [];
    private IReadOnlyDictionary<string, string> _gameNames = new Dictionary<string, string>();
    private IReadOnlyDictionary<ulong, string> _names = new Dictionary<ulong, string>();
    private string? _message;
    private bool _failed;

    protected override async Task LoadAsync()
    {
        _on = await Modules.IsEnabledAsync(Guild!.Id, ServerWatch.ModuleId);
        _canManage = await CanAsync(BotPermissions.ManageGameServers);
        _settings = await Watch.GetSettingsAsync(Guild.Id);
        _canAdd = _canManage || _settings.MembersCanAdd;
        _shown = await Overview.ShowsAsync(Guild.Id, ServerListWidget.KindId);
        await using var db = await DbFactory.CreateDbContextAsync();
        _servers = await db.GameServers.AsNoTracking().Where(s => s.GuildId == Guild.Id).OrderBy(s => s.Game).ThenBy(s => s.Name).ToListAsync();
        _gameNames = (await GameDig.GetGamesAsync()).ToDictionary(g => g.Id, g => g.Name);
        _names = await Names.NamesAsync(Guild.Id, _servers.Select(s => s.OwnerId).Distinct());
    }

    private async Task ActAsync()
    {
        if (!Ready || !_on)
            return;
        var act = Posted("act").Split('|');
        var server = act.Length > 1 && long.TryParse(act[1], out var id) ? _servers.FirstOrDefault(s => s.Id == id) : null;
        (_message, _failed) = act switch
        {
            ["add"] when _canAdd => await AddAsync(),
            ["remove", _] when server is not null && (_canManage || server.OwnerId == Member!.Id) => (await RemoveAsync(server), false),
            ["edit", _] when server is not null && (_canManage || server.OwnerId == Member!.Id) => await EditAsync(server),
            _ => ("That isn't something I can do.", true),
        };
        await LoadAsync();
    }

    private async Task<(string, bool)> AddAsync()
    {
        if (await GameDig.FindGameAsync(Posted("game")) is not { } known)
            return ("Pick a game from the list.", true);
        if (!ServerAddress.TryParse(Posted("address"), out var host, out var port))
            return ("That isn't a valid address. Use host or host:port, like play.example.com:16261.", true);
        if (_servers.Any(s => s.Game == known.Id && s.Host.Equals(host, StringComparison.OrdinalIgnoreCase) && s.Port == port))
            return ("That game server is already added.", true);
        if (_servers.Count >= _settings.MaxServers)
            return ($"There are already {_settings.MaxServers} game servers, the most this server takes.", true);
        if (!_canManage && _servers.Count(s => s.OwnerId == Member!.Id) >= _settings.MaxPerMember)
            return ($"You already have {_settings.MaxPerMember} game servers. Remove one first.", true);
        await Watch.AddAsync(new()
        {
            GuildId = Guild!.Id,
            Game = known.Id,
            Host = host,
            Port = port,
            Name = Posted("name").Trim() is { Length: > 0 } name ? name : null,
            OwnerId = Member!.Id,
            CreatedAt = DateTimeOffset.UtcNow,
        });
        return ($"{known.Name} at {host}{(port is { } p ? $":{p}" : "")} is added.", false);
    }

    private async Task<(string, bool)> EditAsync(GameServer server)
    {
        string? Field(string name, int length) => ServerDetails.Clean(Posted($"{name}-{server.Id}"), length);
        var join = Field("join", ServerDetails.AddressLength);
        var link = Field("link", ServerDetails.LinkLength);
        var shown = Posted($"for-{server.Id}");
        var (passwordFor, role) = shown.StartsWith("role:") && ulong.TryParse(shown[5..], out var roleId) ? (PasswordShown.Role, (ulong?)roleId) : (shown, null);
        if (ServerDetails.Problem(join, link, passwordFor, role) is { } problem)
            return (problem, true);
        var password = Field("password", ServerDetails.PasswordLength);
        var rcon = Field("rcon", ServerDetails.AddressLength);
        var rconPassword = Field("rcon-password", ServerDetails.PasswordLength);
        var inside = false;
        if (rcon is not null)
        {
            if (!ServerAddress.TryParse(rcon, out var rconHost, out var rconPort) || rconPort is null)
                return ("The RCON address has to be host:port, like play.example.com:25575.", true);
            inside = !await PublicAddress.IsPublicAsync(rconHost, CancellationToken.None);
            // Kept inside when the owner put it there; anyone else can't move it in.
            if (inside && (rcon != server.RconAddress || !server.RconInside) && !await Access.IsBotOwnerAsync(Member!.Id))
                return ("That RCON address is inside the bot's own network: only the bot's owner can set one there.", true);
            if (rconPassword is null && server.RconPassword is null)
                return ("Remote control needs its password too.", true);
        }
        await Watch.UpdateAsync(server.Id, Member!.Id, s =>
        {
            s.Name = Field("name", ServerDetails.NameLength);
            s.JoinAddress = join;
            s.Modpack = Field("modpack", ServerDetails.ModpackLength);
            s.ModpackVersion = Field("version", ServerDetails.VersionLength);
            s.ModpackLink = link;
            s.Note = Field("note", ServerDetails.NoteLength);
            s.Password = Passwords.Protect(password);
            (s.PasswordFor, s.PasswordRoleId) = (passwordFor, role);
            (s.RconAddress, s.RconInside, s.AnnounceSessions) = (rcon, inside, Posted($"announce-{server.Id}") == "true");
            s.RconPassword = rcon is null ? null : rconPassword is null ? s.RconPassword : Passwords.Protect(rconPassword);
        });
        if (rcon is null)
            return ($"{server.Name ?? server.Game} changed.", false);
        // Tried at once, so a wrong address or password shows now rather than at the next session.
        await using var db = await DbFactory.CreateDbContextAsync();
        var (_, refused) = await Control.RunAsync((await db.GameServers.FindAsync(server.Id))!, null);
        return refused is null ? ($"{server.Name ?? server.Game} changed; remote control answers.", false) : ($"{server.Name ?? server.Game} changed, but remote control doesn't work: {refused}", true);
    }

    // What players see besides the status: where to join, the modpack, the note, and who gets the password.
    private string About(GameServer server)
    {
        List<string> parts = [];
        if (server.JoinAddress is { } join)
            parts.Add($"join at {join}");
        if (server.Modpack is { } modpack)
            parts.Add($"modpack {modpack}{(server.ModpackVersion is { } version ? $" {version}" : "")}");
        if (server.Password is not null)
            parts.Add(server.PasswordFor switch
            {
                PasswordShown.Card => "password on its card",
                PasswordShown.Role => $"password for @{(server.PasswordRoleId is { } r && Guild!.Roles.TryGetValue(r, out var role) ? role.Name : "a deleted role")}",
                _ => "password with the card's button",
            });
        if (server.Note is { } note)
            parts.Add(note);
        return string.Join(" · ", parts);
    }

    private IEnumerable<Role> Roles() => Guild!.Roles.Values.Where(r => r.Id != Guild.Id && !r.Managed).OrderByDescending(r => r.Position);

    private async Task<string> RemoveAsync(GameServer server)
    {
        await Watch.RemoveAsync(server.Id, Member!.Id);
        return $"{server.Name ?? server.Game} removed.";
    }
}
