<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The chiseled runtime image ships without ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>THOBOTTO</RootNamespace>
    <UserSecretsId>dotnet-src-44d8cede-2db0-4e4b-a161-18b7dea62e96</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
    <PackageReference Include="NodaTime" Version="3.3.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Helpers/Templates/*.json" />
    <EmbeddedResource Include="Helpers/PlainLines.json" />
  </ItemGroup>

</Project>
