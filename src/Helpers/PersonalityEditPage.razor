@page "/g/{GuildId:long}/helpers/{PersonalityId:long}"
@attribute [Authorize]
@inherits GuildPage
@using System.Globalization
@inject PersonalityBook Book
@inject IVoiceCatalogue Voices
@inject ISoundSource Sounds
@inject NavigationManager Navigation

<PageTitle>@(_personality?.Name ?? "Personality") · THOBOTTO</PageTitle>

@if (!Ready || _personality is null)
{
    <p class="muted">There's no such personality, or you aren't in that server.</p>
}
else
{
    <GuildNav Guild="Guild" Current="helpers" />
    <h1>@_personality.Name</h1>
    @if (!_canChange)
    {
        <p class="muted">Changing it needs <code>@BotPermissions.ManageHelpers</code>.</p>
    }
    @if (_message is not null)
    {
        <p class="notice @(_failed ? "bad" : "good")">@_message</p>
    }
    <form method="post" enctype="multipart/form-data" @formname="personality" @onsubmit="SaveAsync">
        <AntiforgeryToken />
        <section class="card">
            <h2>Look</h2>
            <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" value="@_personality.Name" maxlength="32" disabled="@(!_canChange)" />
                <small class="muted">Helpers wearing it go by this name in this server.</small>
            </div>
            <div class="field">
                <label for="also">Also answers to</label>
                <input id="also" name="also" value="@string.Join(", ", _personality.AlsoAnswersTo)" maxlength="400" placeholder="Javes, Eaves, Yives" disabled="@(!_canChange)" />
                <small class="muted">What speech to text hears instead of the name (the voice log shows it), separated by commas: voice commands answer to these too.</small>
            </div>
            <div class="field">
                <label for="color">Colour</label>
                <span class="with-unit">
                    <input id="color" name="color" type="color" value="#@((_personality.Color ?? PersonalityFile.Plain.ColorValue!.Value).ToString("x6"))" disabled="@(!_canChange)" />
                    <label class="check"><input type="checkbox" name="plain-color" value="true" checked="@(_personality.Color is null)" disabled="@(!_canChange)" /> Default</label>
                </span>
                <small class="muted">Of its now-playing messages.</small>
            </div>
            <div class="field">
                <label for="avatar">Avatar in this server</label>
                <span class="row">
                    @if (_personality.Avatar is { } avatar)
                    {
                        <img class="avatar" src="data:@(_personality.AvatarType);base64,@Convert.ToBase64String(avatar)" alt="Current avatar" />
                        <label class="check"><input type="checkbox" name="remove-avatar" value="true" disabled="@(!_canChange)" /> Remove</label>
                    }
                    <input id="avatar" name="avatar" type="file" accept="image/png,image/jpeg,image/gif,image/webp" disabled="@(!_canChange)" />
                </span>
                <small class="muted">PNG, JPEG, GIF or WebP, at most 2 MB. Discord limits how often a bot's avatar can change.</small>
            </div>
            @if (Voices.On)
            {
                <div class="field">
                    <label for="engine">Speaks through</label>
                    <select id="engine" name="engine" disabled="@(!_canChange)" onchange="engineChanged()">
                        <option value="" selected="@(_personality.Engine is null)">The server's pick (@Voices.EngineName(Voices.Engine))</option>
                        @foreach (var (id, label) in Voices.Engines)
                        {
                            <option value="@id" selected="@(_personality.Engine == id)">@label</option>
                        }
                        @if (_personality.Engine is { } kept && Voices.Engines.All(e => e.Id != kept))
                        {
                            <option value="@kept" selected>@Voices.EngineName(kept) (not set up here)</option>
                        }
                    </select>
                    @if (_personality.Engine is { } wanted && Voices.Engines.All(e => e.Id != wanted))
                    {
                        <small class="problem">It would rather speak through @Voices.EngineName(wanted), which isn't set up here, so it speaks with @Voices.EngineName(_engine).</small>
                    }
                </div>
                <div class="field">
                    <label for="voice">Voice (<span id="voice-engine">@Voices.EngineName(_engine)</span>)</label>
                    <span class="row">
                        <select id="voice" name="voice" disabled="@(!_canChange)" onchange="previewLine('')"></select>
                        <select id="variant" name="variant" aria-label="Variant" disabled="@(!_canChange)" onchange="previewLine('')"></select>
                        <audio id="preview" controls preload="none" src="@(Voices.PreviewLink(Guild!.Id, _personality.Id))"></audio>
                    </span>
                    <input id="blend" name="blend" maxlength="64" placeholder="af_sky+af_bella, or af_sky(2)+af_bella(1)" disabled="@(!_canChange)" />
                    <small id="voice-note" class="muted"></small>
                    <small class="muted">What it sounds like when helpers wearing it speak in voice. Each engine keeps its own pick. The preview plays what the page has right now: the engine, the voice, the effects and, from a moment's play button, its first line as typed.</small>
                    <script>
                        const voiceLists = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(_lists));
                        const voiceDefaults = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(_defaults));
                        const voiceVariants = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(_variants));
                        const voiceBlends = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(_blends));
                        const voiceNames = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(_names));
                        const savedPicks = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(_personality.Voices));
                        const serverEngine = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(Voices.Engine));
                        const field = (id) => document.getElementById(id);
                        function spokenEngine() {
                            const wanted = field('engine').value;
                            return voiceLists[wanted] ? wanted : serverEngine;
                        }
                        function fill(select, options, chosen, none) {
                            select.innerHTML = '';
                            const first = document.createElement('option');
                            first.value = '';
                            first.textContent = none;
                            select.append(first);
                            for (const option of options) {
                                const item = document.createElement('option');
                                item.value = option;
                                item.textContent = option;
                                item.selected = option === chosen;
                                select.append(item);
                            }
                        }
                        function engineChanged() {
                            const engine = spokenEngine();
                            const saved = savedPicks[engine] || '';
                            const variants = voiceVariants[engine] || [];
                            const blends = !!voiceBlends[engine];
                            const base = blends ? (saved.includes('+') ? '' : saved) : saved.split('+')[0];
                            field('voice-engine').textContent = voiceNames[engine] || engine;
                            fill(field('voice'), voiceLists[engine] || [], base, 'Default (' + (voiceDefaults[engine] || '') + ')');
                            fill(field('variant'), variants, saved.includes('+') && !blends ? saved.split('+')[1] : '', 'No variant');
                            field('variant').hidden = variants.length === 0;
                            field('blend').hidden = !blends;
                            field('blend').value = blends && saved.includes('+') ? saved : '';
                            const listed = (voiceLists[engine] || []).length > 0;
                            field('voice-note').textContent = !listed ? "The speech engine didn't list its voices; check it on the Integrations page."
                                : base && !(voiceLists[engine] || []).includes(base) ? '“' + base + "” isn't one of this engine's voices, so it speaks with the default; pick another."
                                : variants.length > 0 ? 'A variant changes the voice: m1 to m7 are male, f1 to f5 female, croak and whisper what they say, klatt the old synthesizer.'
                                : blends ? "Or a blend of Kokoro's voices in the field, weighted in brackets, instead of the pick above." : '';
                        }
                        function previewLine(moment) {
                            const line = moment ? (field(moment).value.split('\n')[0] || '') : '';
                            const effects = Array.from(document.querySelectorAll('input[name^="effect-"]')).map(i => i.name.slice(7) + ':' + i.value).join(',');
                            const variant = field('variant').hidden ? '' : field('variant').value;
                            const voice = !field('blend').hidden && field('blend').value ? field('blend').value : field('voice').value + (variant ? '+' + variant : '');
                            const player = field('preview');
                            player.src = '@(Voices.PreviewLink(Guild!.Id, _personality.Id))?t=' + Date.now() + '&engine=' + encodeURIComponent(field('engine').value)
                                + '&voice=' + encodeURIComponent(voice) + '&effects=' + encodeURIComponent(effects) + '&line=' + encodeURIComponent(line);
                            player.play();
                        }
                        engineChanged();
                    </script>
                </div>
            }
        </section>

        <section class="card">
            <h2>Voice effects</h2>
            <p class="muted">How the voice is shaped after the engine, whichever engine speaks; the defaults are none. The preview above plays them.</p>
            @foreach (var (name, min, max, step, what) in VoiceEffects.Known)
            {
                <div class="field">
                    <label for="effect-@name">@(char.ToUpperInvariant(name[0]) + name[1..]) <span class="muted">(@what)</span></label>
                    <input id="effect-@name" name="effect-@name" type="number" min="@min" max="@max" step="@step" value="@((_personality.Effects.TryGetValue(name, out var set) ? set : VoiceEffects.Default(name)).ToString(CultureInfo.InvariantCulture))" disabled="@(!_canChange)" />
                </div>
            }
        </section>

        <section class="card">
            <h2>Lines</h2>
            <p class="muted">Voice marks in a line: <code>[pause]</code>, <code>[pause 1s]</code>, <code>[slow]…[/slow]</code>, <code>[fast]…[/fast]</code>, <code>[high]…[/high]</code>, <code>[low]…[/low]</code>, <code>[spell]404[/spell]</code>, <code>[glitch]…[/glitch]</code>, <code>[sound airhorn]</code> (a library sound by name, or one of Discord's own; skipped where a server lacks it). The chat copy drops them.</p>
            @if (_missingSounds.Count > 0)
            {
                <p class="problem">Sounds these lines name that this server doesn't have: @string.Join(", ", _missingSounds). They're skipped here.</p>
            }
            <p class="muted">One per line; one is picked at random. <code>{track}</code>, <code>{user}</code>, <code>{channel}</code> and <code>{helper}</code> are filled in. Empty uses plain lines.</p>
            @foreach (var moment in Moments.All)
            {
                <div class="field">
                    <label for="@moment">@Label(moment)@if (Voices.On) { <button type="button" class="link" onclick="previewLine('@moment')">▶ hear</button> }</label>
                    <textarea id="@moment" name="@moment" rows="3" disabled="@(!_canChange)">@string.Join('\n', _personality.Phrases.GetValueOrDefault(moment) ?? [])</textarea>
                </div>
            }
        </section>
        @if (_canChange)
        {
            <div class="row">
                <button class="button" name="act" value="save">Save</button>
                <details>
                    <summary class="muted">Delete</summary>
                    <button class="button small danger" name="act" value="delete">Delete @_personality.Name</button>
                    <small class="muted">Helpers wearing it go back to their own name.</small>
                </details>
            </div>
        }
    </form>

    <section class="card">
        <h2>Share</h2>
        <p class="muted">A file with its name, colour, avatar and lines, to keep or import in another server.</p>
        <div class="row">
            <a class="button small secondary" href="/g/@Guild.Id/helpers/@_personality.Id/download">⬇️ Download as file</a>
        </div>
        @if (_targets.Count > 0)
        {
            <form method="post" @formname="personality-copy" @onsubmit="CopyAsync" class="row">
                <AntiforgeryToken />
                <select name="target" aria-label="Server to copy to">
                    @foreach (var target in _targets)
                    {
                        <option value="@target.Id">@target.Name</option>
                    }
                </select>
                <button class="button small">Copy to that server</button>
            </form>
        }
    </section>
}

@code {
    [Parameter]
    public long PersonalityId { get; set; }

    private Personality? _personality;
    // Other servers where the member may add personalities.
    private List<NetCord.Gateway.Guild> _targets = [];
    private bool _canChange;
    private IReadOnlyList<string> _voices = [];
    private string _engine = "";
    private IReadOnlyList<string> _missingSounds = [];
    private Dictionary<string, IReadOnlyList<string>> _lists = [];
    private Dictionary<string, string> _defaults = [];
    private Dictionary<string, IReadOnlyList<string>> _variants = [];
    private Dictionary<string, bool> _blends = [];
    private Dictionary<string, string> _names = [];
    private string? _message;
    private bool _failed;

    protected override async Task LoadAsync()
    {
        _canChange = await CanAsync(BotPermissions.ManageHelpers);
        _personality = await Book.FindAsync(Guild!.Id, PersonalityId);
        _engine = Voices.On ? Voices.EngineFor(_personality) : "";
        List<string> named = _personality is null ? [] : _personality.Phrases.Values.SelectMany(lines => lines).SelectMany(VoiceMarks.Sounds).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var missing = new List<string>();
        foreach (var name in named)
        {
            if (!await Sounds.HasAsync(Guild.Id, name))
                missing.Add(name);
        }
        _missingSounds = missing;
        _voices = Voices.On ? await Voices.VoicesAsync(_engine) : [];
        foreach (var (id, label) in Voices.Engines)
        {
            _lists[id] = await Voices.VoicesAsync(id);
            _defaults[id] = Voices.DefaultVoice(id);
            _variants[id] = Voices.VariantsOf(id);
            _blends[id] = Voices.Blends(id);
            _names[id] = label;
        }
        _targets = [];
        foreach (var guild in await Access.GuildsAsync(Member!.Id))
        {
            if (guild.Id != Guild.Id && await Access.InAsync(guild.Id, Member.Id) is { } there && await Access.CanAsync(there.Guild, there.Member, BotPermissions.ManageHelpers))
                _targets.Add(there.Guild);
        }
    }

    private async Task CopyAsync()
    {
        if (!Ready || _personality is null || !ulong.TryParse(Posted("target"), out var targetId) || _targets.FirstOrDefault(t => t.Id == targetId) is not { } target)
            return;
        var copy = await Book.CreateAsync(target.Id, _personality.Name, PersonalityFile.From(_personality), Member.Id);
        _message = $"Copied {copy.Name} to {target.Name}.";
    }

    private static string Label(string moment) => moment switch
    {
        Moments.Joined => "Joining a voice channel",
        Moments.Playing => "Playing a track",
        Moments.Skipped => "Skipping",
        Moments.Stopped => "Stopped",
        Moments.Finished => "Queue ran out, leaving",
        Moments.Lonely => "Nobody listening, leaving",
        Moments.Wrapped => "Presenting its Wrapped ({period})",
        Moments.Thinking => "Thinking (said out loud while a request takes a moment)",
        _ => moment,
    };

    private async Task SaveAsync()
    {
        if (Guild is null || _personality is null || !_canChange)
            return;
        var form = HttpContext.Request.Form;
        if (form["act"] == "delete")
        {
            await Book.DeleteAsync(Guild.Id, _personality.Id, Member!.Id);
            Navigation.NavigateTo($"/g/{Guild.Id}/helpers");
            return;
        }

        var name = form["name"].ToString().Trim();
        if (name.Length is 0 or > 32)
        {
            (_message, _failed) = ("The name needs 1 to 32 characters.", true);
            return;
        }
        int? color = form["plain-color"] == "true" ? null
            : int.TryParse(form["color"].ToString().TrimStart('#'), NumberStyles.HexNumber, null, out var parsed) ? parsed : _personality.Color;

        byte[]? avatar = null;
        string? avatarType = null;
        if (form.Files["avatar"] is { Length: > 0 } file)
        {
            if (file.Length > PersonalityBook.MaxAvatarBytes || file.ContentType is not ("image/png" or "image/jpeg" or "image/gif" or "image/webp"))
            {
                (_message, _failed) = ("The avatar has to be a PNG, JPEG, GIF or WebP of at most 2 MB.", true);
                return;
            }
            using var stream = new MemoryStream();
            await file.CopyToAsync(stream);
            (avatar, avatarType) = (stream.ToArray(), file.ContentType);
        }
        var removeAvatar = form["remove-avatar"] == "true";
        var engine = form["engine"].ToString().Trim() is { Length: > 0 } wanted ? wanted : null;
        if (engine is not null && !PersonalityFile.Engines.Contains(engine))
        {
            (_message, _failed) = ("That isn't a speech engine.", true);
            return;
        }
        var spoken = Voices.EngineFor(engine);
        var voice = Voices.Blends(spoken) && form["blend"].ToString().Trim() is { Length: > 0 } blend ? blend : form["voice"].ToString().Trim();
        if (voice.Length > 0 && !voice.Contains('+') && !(await Voices.VoicesAsync(spoken)).Contains(voice))
        {
            (_message, _failed) = ("That voice isn't one the speech engine has.", true);
            return;
        }
        if (voice.Length > 0 && form["variant"].ToString().Trim() is { Length: > 0 } variant && Voices.VariantsOf(spoken).Contains(variant))
            voice += "+" + variant;
        var phrases = Moments.All.ToDictionary(m => m, m => form[m].ToString().Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0).Take(50).ToList());
        if (phrases.SelectMany(x => x.Value).Select(VoiceMarks.Problem).FirstOrDefault(x => x is not null) is { } badMark)
        {
            (_message, _failed) = ($"A line: {badMark}.", true);
            return;
        }
        var effects = new Dictionary<string, double>();
        foreach (var (effect, _, _, _, _) in VoiceEffects.Known)
        {
            if (double.TryParse(form[$"effect-{effect}"], NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && Math.Abs(value - VoiceEffects.Default(effect)) > 1e-9)
                effects[effect] = value;
        }
        if (VoiceEffects.Problem(effects) is { } badEffect)
        {
            (_message, _failed) = (badEffect, true);
            return;
        }
        var also = PersonalityFile.ReadAlsoAnswersTo(form["also"].ToString());
        await Book.ChangeAsync(Guild.Id, _personality.Id, Member!.Id, "panel", p =>
        {
            p.Name = name;
            p.Effects = effects;
            p.Engine = engine;
            p.AlsoAnswersTo = also;
            p.Color = color;
            if (avatar is not null)
                (p.Avatar, p.AvatarType) = (avatar, avatarType);
            else if (removeAvatar)
                (p.Avatar, p.AvatarType) = (null, null);
            p.Phrases = phrases.Where(x => x.Value.Count > 0).ToDictionary(x => x.Key, x => x.Value);
            if (Voices.On)
            {
                var voices = new Dictionary<string, string>(p.Voices);
                if (voice is { Length: > 0 })
                    voices[spoken] = voice;
                else
                    voices.Remove(spoken);
                p.Voices = voices;
            }
        });
        (_message, _failed) = ("Saved; helpers wearing it show it now.", false);
        await LoadAsync();
    }
}
